def notebook_model_answer(job, route, png, context, image_context=LATEST_IMAGE_CONTEXT, prestart=None):
	"""Bounded isolated generation; publish only to its unchanged pending job."""
	path, request = job[1], job[4]
	stop_reason = None
	observed_response = None
	semantic_rejected = False
	def observe_response(raw):
		nonlocal observed_response
		observed_response = raw  # immutable bounded envelope; no publication
	streaming = route.get('response_format') == 'story-stream-v1'
	def bound():
		return (notebook_jobs.get(request) == job and pend('').get(path) == job and
			answers.get(path) == 'waiting' and time.time()-job[2] < ANSWER_WAIT)
	def current():
		nonlocal stop_reason
		with pending_lock:
			if not bound():
				return False
			if stop_reason is not None:
				return False  # Returning to the page cannot revive an already-cancelled call.
			stop_reason = model_page_stop_reason(context)
			return stop_reason is None
	def on_answer(chunk):
		# Revalidate the callback boundary too, including injected providers.
		from notebook_lesson import _text
		with pending_lock:
			if not current(): raise ModelTransportError('cancelled')
			stream = notebook_answer_streams[request]
			if (not isinstance(chunk,dict) or set(chunk) != {'sequence','text'} or
				type(chunk['sequence']) is not int or chunk['sequence'] != len(stream['chunks']) or
				len(stream['chunks']) >= 3):
				raise ModelTransportError('invalid_response')
			text = _text(chunk['text'],160)
			text.encode('utf-8')
			if sum(len(c['text']) for c in stream['chunks'])+len(text)>400:
				raise ModelTransportError('reply_too_large')
			stream['chunks'].append(dict(sequence=chunk['sequence'],text=text))
			reply_timings.setdefault(path,{}).setdefault('answer_chunk_queued',time.monotonic())
	try:
		started = time.monotonic()
		if streaming:
			with pending_lock:
				if not current() or request in notebook_answer_streams:
					raise ModelTransportError('cancelled')
				# Bound storage by active pages, not the lifetime of the server.
				active = {j[4] for j in pend('').values() if len(j)>4 and time.time()-j[2]<ANSWER_WAIT}
				for old in list(notebook_answer_streams):
					if old not in active: notebook_answer_streams.pop(old)
				notebook_answer_streams[request] = dict(context=dict(context),chunks=[],stopped=False)
		if route.get('response_format') in ('story-panel-v1','story-stream-v1','role-production-v1'):
			result = generate_notebook_story(route.get('socket'), request, png,
				deadline_ms=route['deadline_ms'], is_current=current, image_context=image_context,
				**({'roles':route['roles']} if route.get('response_format') == 'role-production-v1' else {}),
				**({'on_answer':on_answer} if streaming else {}))
		else:
			# A reply the checker refuses gets two more tries, told why. Nothing has reached the page yet.
			# (IRIS, 2026-10-30: a layout refusal, then a retry that wrote a number as a word.)
			image_context = lesson_notes(image_context, path)
			if not prestart and not waiting_send(path):
				image_context = with_story(image_context, png, None, request, path)
			attempt_context, refused_layout = image_context, False
			for attempt in (1, 2, 3):
				try:
					if attempt == 1 and prestart:
						# Asked while the Primer's pen wrote the question: this press's checks above, that answer.
						prestart['current'] = current
						trace.event('composed', 'prestarted', request=request, path=path, ready=prestart['done'].is_set())
						prestart['done'].wait(route['deadline_ms']/1000)
						observed_response = prestart['observed']
						image_context = prestart.get('context') or image_context
						attempt_context = image_context  # an answer the prestart did not finish is asked again with its tale
						if isinstance(prestart['error'], ModelTransportError):
							raise prestart['error']
						if prestart['result'] is not None and current():
							result = prestart['result']
							break
					result = call_notebook_model(route['socket'], request, png,
						attempt_context,
						deadline_ms=route['deadline_ms'], is_current=current, observe_response=observe_response)
					break
				except ModelTransportError as error:
					semantic_rejected = error.code in ('invalid_response','invalid_json') and observed_response is not None
					detail = getattr(error, 'detail', None)
					if attempt == 3 or not semantic_rejected or not detail or not current():
						raise
					trace.event('composed', 'retry', request=request, path=path, reason=detail)
					observed_response = None
					# Once a scene would not fit, every later try is steered away from it.
					refused_layout = refused_layout or 'simplify the scene' in detail
					attempt_context = image_context + REPAIR_NOTE % detail + (LAYOUT_REPAIR_NOTE if refused_layout else '')
		trace.event('composed', request=request, path=path, ms=round((time.monotonic()-started)*1000))
		try:
			reply = json.loads(result['text'])
		except (TypeError, ValueError):
			reply = {}
		parsed = result.get('parsed') or {}
		trace.event('rendered', request=request, path=path, mode=parsed.get('mode') or reply.get('mode'),
			intent=reply.get('intent') if isinstance(reply, dict) else None,
			labels_left_out=[text for _, text in (parsed.get('plan') or {}).get('dropped_labels', [])] or None)
		waiting = None
		if parsed.get('mode') in ('send', 'confirm'):
			text, waiting = page_send(parsed, request, path, current)
			result['text'] = json.dumps({'v': 1, 'mode': 'answer', 'text': text})
			if observed_response is not None:
				# Kept as the page shows it: the Primer speaks this, and a replay can never send again.
				observed_response = json.dumps(dict(json.loads(observed_response), text=result['text'])).encode()
		if observed_response is not None:
			keep_reply(request, observed_response)
		if (parsed.get('mode') == 'lesson' and 'picture' not in parsed and
				isinstance(reply, dict) and lesson_rollout_config().get('picture') == 'image'):
			# A picture the checker refused (IRIS reply, 2026-10-30: wrong edit count) is directed afresh, like a missing one.
			refused = parsed.pop('picture_refused', None)
			directed = direct_picture(reply)
			trace.event('picture', 'directed' if directed else 'refused' if refused else 'missing', request=request, path=path,
				reason=(refused and 'refused: ' + refused) if directed or refused else
					'the lesson came without a picture and none could be directed')
			if directed:
				reply['picture'] = parsed['picture'] = directed
				result['text'] = json.dumps(reply)
		if parsed.get('picture') and lesson_rollout_config().get('picture') == 'image':
			# Render now, off the tablet's request; preparation later reads only the cached frames.
			drawn = time.monotonic()
			try:
				rendered = notebook_image_model.frames(parsed['picture']['base'], parsed['picture']['edits'], scenes=SCENES)
				notebook_image_model.keep(request, rendered, dict(parsed['picture'], scenes=SCENES))
				located = locate_labels(parsed['picture'], rendered, request, path)
				trace.event('picture', request=request, path=path, frames=len(rendered), labels=located,
					ms=round((time.monotonic()-drawn)*1000))
			except Exception as error:  # the procedural drawing stands
				trace.event('picture', 'failed', request=request, path=path, reason=f'{type(error).__name__}: {error}'[:300])
		with pending_lock:
			if not current():
				raise ModelTransportError('cancelled')
			notebook_reply(request, result['text'])
			if waiting:
				pending_sends[path] = waiting
			timings = reply_timings.setdefault(path,{})
			timings['model_completed'] = time.monotonic()
			first = result['metrics']['first_text_ms']
			if first is not None:
				timings['model_first_text'] = started+first/1000
	except Exception as error:
		trace.event('composed', 'failed', request=request, path=path, code=getattr(error, 'code', type(error).__name__),
			reason=getattr(error, 'detail', None) or str(error), stop=stop_reason)
		with pending_lock:
			if streaming and request in notebook_answer_streams:
				notebook_answer_streams[request]['stopped'] = True
			if bound():
				answers[path] = 'failed'
				code = error.code if isinstance(error,ModelTransportError) else 'invalid_response'
				if semantic_rejected:
					try:
						retain_rejected_reply(CACHE, request, observed_response)
					except (OSError, ValueError):
						print('Notebook rejection evidence unavailable; reply still held', file=sys.stderr, flush=True)
				if code == 'cancelled' and stop_reason is not None:
					reply_errors[path] = 'Notebook model '+stop_reason+'; request stopped before insertion; no automatic resend'
				else:
					reply_errors[path] = 'Notebook model '+code+'; reply held, no automatic resend'


def replay_picture(replay, result, request, path):
	"""Puts the frames the replayed reply drew back in the cache, so the replay draws its picture, not a new one.
	The picture is the one kept with the frames (Long Island Sound's was directed, 2026-10-31), else the parsed reply's:
	a kept raw reply can be ragged JSON (the raven, 2026-10-30)."""
	try:
		parsed = result.get('parsed') or {}
		picture = notebook_image_model.kept_picture(replay) or parsed.get('picture') or {}
		count = notebook_image_model.replayed(replay, picture['base'], picture.get('edits') or [],
			scenes=picture.pop('scenes', False))
		if count and parsed.get('mode') == 'lesson' and parsed.get('picture') != picture:
			# Drawn as it was then, not refused or directed afresh; preparation reads the picture from the text.
			reply = json.loads(result['text'])
			reply['picture'] = parsed['picture'] = picture
			parsed.pop('picture_refused', None)
			result['text'] = json.dumps(reply)
		trace.event('picture', 'replayed' if count else 'not kept', request=request, path=path, replay=replay, frames=count)
	except (KeyError, TypeError, ValueError, AttributeError, OSError) as error:  # it is drawn afresh, as before
		trace.event('picture', 'not kept', request=request, path=path, replay=replay, reason=f'{type(error).__name__}: {error}'[:200])


def keep_reply(request, raw):
	"""A private copy of each accepted model reply, newest 200, for herd-board-replay. Never read by Respond."""
	try:
		retain_reply(CACHE, request, raw)
		folder = os.path.join(CACHE, 'replies')
		kept = sorted((os.path.join(folder, n) for n in os.listdir(folder) if n.startswith('notebook-')), key=os.path.getmtime)
		for old in kept[:-200]:
			os.unlink(old)
	except (OSError, ValueError) as e:
		print(time.strftime('%T'), 'reply copy unavailable:', type(e).__name__, e, file=sys.stderr, flush=True)


def validate_lesson_notebooks(selected):
	if (not isinstance(selected, list) or len(selected) > 128 or
		any(not isinstance(value,str) or str(uuid.UUID(value)) != value for value in selected)):
		raise ValueError('lesson rollout requires canonical notebook UUIDs')


def lesson_enabled(doc):
	"""Fail closed on malformed operator rollout configuration."""
	if LESSON_NOTEBOOKS is not None:
		selected = LESSON_NOTEBOOKS.split(',') if LESSON_NOTEBOOKS else []
	else:
		selected = lesson_rollout_config()['notebooks']
	validate_lesson_notebooks(selected)
	return doc in selected


def prepare_notebook_lesson_import(path, bundle):
	"""Stage a validated archive; native QML imports it before any foreground edit."""
	context = native_ack_context(path)
	content_revision = device_context.snapshot().get('content_revision')
	if context is None:
		raise ValueError('native lesson requires active page telemetry')
	def guard():
		if native_ack_context(path) != context or device_context.snapshot().get('content_revision') != content_revision:
			raise ValueError('Page, viewport or handwriting changed during lesson preparation')
	guard()
	meta = json.loads(tablet(f'cat {XOCHITL}/{LESSON_SOURCE_TEMPLATE}.metadata'))
	parent = meta.get('parent')
	if not isinstance(parent, str) or str(uuid.UUID(parent)) != parent:
		raise ValueError('native lesson source folder unavailable')
	folder = json.loads(tablet(f'cat {XOCHITL}/{parent}.metadata'))
	if folder.get('visibleName') != 'Storyboard tests (Codex)':
		raise ValueError('native lesson source template is outside its dedicated folder')
	template = json.loads(tablet(f'cat {XOCHITL}/{LESSON_SOURCE_TEMPLATE}.content'))
	doc, archive = lesson_source_archive(bundle, template, parent)
	guard()
	remote = '/home/root/.cache/herd-board/imports/'+doc+'.rmdoc'
	if tablet(f'mkdir -p /home/root/.cache/herd-board/imports && test ! -e {remote} '
		f'&& (set -C; cat > {remote}.new) && mv {remote}.new {remote} && printf archive-staged', archive) != b'archive-staged':
		raise ValueError('native lesson archive staging failed')
	if tablet(f'dd if={remote} bs=2000001 count=1 2>/dev/null') != archive:
		raise ValueError('native lesson archive readback mismatch')
	guard()
	command = dict(doc=doc, parent=parent, pages=len(bundle['sources']))
	if bundle.get('mode') == 'story':
		command['story_version'] = 1
	return dict(context=context, content_revision=content_revision, command=command)


def native_ink_current(request):
	job = notebook_jobs.get(request)
	if not job or len(job) < 7 or job[6] is not True or answer_status(job[1])['request'] != request or answers.get(job[1]) != 'writing':
		raise ValueError('native ink request is no longer the current writing reply')
	return job


def generated_ink(block):
	# The compiler's final equation is a separate bounded scene, not one of
	# the authored FACTORIES. It shares the lesson rollout and blank-area guard.
	return (block['scene'].startswith('lesson-') or (block.get('role') == 'equation' and block['scene'].startswith('equation-'))
		or (block.get('role') == 'hand' and block['scene'].startswith('hand-')))


def ink_scene_known(block):
	return generated_ink(block) or block['scene'] in FACTORIES


def native_ink_preflight(block, query, context, first):
	native_ink_current(query['request'])
	native_ink_source(block)
	if not ink_scene_known(block):
		raise ValueError(f"drawing not in the catalog: {block['scene']}")
	generated = generated_ink(block)
	# Roll out ONLY on the newly provisioned diagnostic notebook until the
	# complete ordered response, preservation and reopen tests have passed.
	if generated:
		if not lesson_enabled(context['doc']):
			raise ValueError('native lessons are not enabled for this notebook')
	else:
		metadata = json.loads(tablet(f"cat {XOCHITL}/{context['doc']}.metadata"))
		parent = metadata.get('parent')
		if not isinstance(parent, str) or str(uuid.UUID(parent)) != parent:
			raise ValueError('native ink diagnostic folder identity missing')
		folder = json.loads(tablet(f"cat {XOCHITL}/{parent}.metadata"))
		if metadata.get('visibleName') != 'To pidog' or folder.get('visibleName') != 'Storyboard tests (Codex)':
			raise ValueError('ordered native ink is currently restricted to its isolated test notebook')
	if first:
		from notebook_device import project_region, project_storyboard
		if generated:
			x0,y0,x1,y1 = project_region(block['width'], block['height'], context, query['origin'])
		else:
			x0,y0,x1,y1 = project_storyboard(FACTORIES[block['scene']](), context, query['origin'])['bounds']
		box = (math.floor(x0)-3, math.floor(y0)-3, math.ceil(x1)+3, math.ceil(y1)+3)
		# Same full-resolution reservation and three-pixel margin; transfer only
		# its framebuffer rows. Page/input and request revalidation stay unchanged.
		region = live_capture_region(tablet, box)
		if region.point(lambda value: 255 if value < 110 else 0).getbbox():
			raise ValueError('native diagram reservation contains existing content')
	native_ink_current(query['request'])  # revalidate after potentially slow native I/O


def claim_native_ink(body):
	job = native_ink_current(body.get('request'))
	result = native_ink_runs.claim(body, device_context.snapshot, native_ink_preflight)
	reply_timings.setdefault(job[1], {})['ink_'+body['scene']+'_'+body['stage']+'_claimed'] = time.monotonic()
	return result


def complete_native_ink(body):
	job = native_ink_current(body.get('request'))
	result = native_ink_runs.complete(body)
	reply_timings.setdefault(job[1], {}).setdefault('ink_'+body['scene']+'_'+body['stage']+'_committed', time.monotonic())
	return result


def native_saved_page(path):
	return tablet(f'if test -f {XOCHITL}/{path}; then dd if={XOCHITL}/{path} bs=1024 count=16384 2>/dev/null; fi')


def native_ink_proof(request, layout=None):
	native_ink_current(request)
	if layout is not None:
		if (not isinstance(layout, dict) or layout.get('command', {}).get('request') != request or
			layout.get('command', {}).get('phase') != 'after'):
			raise ValueError('native after-layout measurement belongs to another reply')
		measured = native_ink_runs.finish_capture(layout, device_context.snapshot, native_saved_page)
		native_ink_current(request)
		if measured.get('state') == 'waiting':
			# Return to the EXISTING bounded save poll, not an immediate capture
			# loop. Counts only; no notebook text is logged.
			print(time.strftime('%T'), 'native save pending', measured['reason'], file=sys.stderr, flush=True)
			return measured
	proof = native_ink_runs.saved_proof(request, native_saved_page, native_ink_source, device_context.snapshot)
	# Why a drawing is not yet proven saved; repeated polls with the same reason log once.
	trace.event('ink_proof', proof['state'], request=request,
		reason=proof.get('reason') or ('measure layout' if 'measure_layout' in proof else None), strokes=proof.get('strokes'))
	return proof


def matching_native_attempt(job):
	if not isinstance(job, list) or len(job) < 7 or job[6] is not True:
		return False
	try:
		with open(live_baseline(job[1]) + '.native-attempt') as stream:
			return stream.read(200) == job[4]
	except OSError:
		return False


NOTEBOOK_PENDING_LIMIT = 300  # seconds a model request may stay pending (not mid-write) before it is cleared


def trace_image(request, what, image):
	"""Keep a frame a check judged, for the trace (the newest 200 are kept). -> its path"""
	folder = os.path.join(os.path.dirname(trace.TRACE), 'herd-board-trace-frames')  # beside the trace it explains
	out = f"{folder}/{request}-{what}.png"
	try:
		os.makedirs(folder, exist_ok=True)
		image.save(out)
		for old in sorted(glob.glob(folder + "/*.png"), key=os.path.getmtime)[:-200]:
			os.remove(old)
	except Exception as e:  # evidence only: never let it stop the request
		return f'unsaved: {type(e).__name__}'
	return out


def clear_pending(path, job, reason, state='failed'):
	"""Drop the page's pending request, keeping its id for the tablet's status poll. A late model reply or callback for
	it then fails its binding (the job is no longer the page's pending one), so nothing it made reaches the page."""
	with pending_lock:
		if pend('').get(path) != job:
			return
		pend(path)
		ready.pop(path, None)
		lesson_imports.pop(path, None)
		answers[path] = state
		reply_errors[path] = reason
		trace.event('cleared', state, request=job[4], path=path, reason=reason)


def check_replaceable(path, job):
	"""May a new Respond on this page replace the model request still pending there? The new one cancels the old
	one up front (once its own capture succeeds), rather than the old one's work being thrown away at the end.
	Refused, with a reason the tablet shows: a reply being written now, and an older kind of request. A reply that
	may be partly written is cleared but refused once, so its owner looks at the page before asking again.
	Caller holds pending_lock."""
	if not isinstance(job, list) or len(job) < 7 or delivery_options(job).get('model_transport') != 'pi-socket-v1':
		raise ValueError('A notebook request is already pending on this page')
	state = answers.get(path)
	if state == 'writing' and time.time() - job[2] < 2 * NOTEBOOK_PENDING_LIMIT:
		raise ValueError('A notebook request is already pending on this page')
	try:
		with native_ink_runs.lock:
			native_ink_runs.require_unprepared(job[4])
		started = state == 'writing' or not native_retry_safe(job)
	except (ValueError, OSError):
		started = True
	if started:
		clear_pending(path, job, 'Tablet stopped while inserting this reply; inspect the page before retrying')
		raise ValueError('Tablet stopped while inserting this reply; inspect the page before retrying')


def sweep_pending():
	"""Clear model requests that have sat pending too long; each one is logged with why."""
	with pending_lock:
		for path, job in list(pend('').items()):
			if not isinstance(job, list) or len(job) < 7 or delivery_options(job).get('model_transport') != 'pi-socket-v1':
				continue
			age, state = time.time() - job[2], answers.get(path)
			if state == 'writing' and age > 2 * NOTEBOOK_PENDING_LIMIT:
				clear_pending(path, job, 'Tablet stopped while inserting this reply; inspect the page before retrying')
			elif state != 'writing' and age > NOTEBOOK_PENDING_LIMIT:
				clear_pending(path, job, f'Timed out after {round(age)} s while {state}', state='no answer')


def expire_pending():
	while True:
		time.sleep(30)
		try:
			sweep_pending()
		except Exception as e:
			print(time.strftime('%T'), 'pending sweep:', type(e).__name__, e, file=sys.stderr, flush=True)


def model_request_replaceable(job, supersedes):
	"""Explicit new question, not permission to replay/acknowledge old output.

	Caller holds pending_lock; the post-capture check also holds the ink lock
	through new job creation. Old request journals/content stay untouched and
	late callbacks still fail their current-request binding.
	"""
	if not supersedes:
		return failed_model_replaceable(job)
	if (not isinstance(job, list) or len(job) < 7 or job[4] != supersedes or
		delivery_options(job).get('model_transport') != 'pi-socket-v1' or
		answers.get(job[1]) != 'failed'):
		return False
	return failed_model_replaceable(job) or (job[5] is not None and matching_native_attempt(job))


def failed_model_replaceable(job):
	"""A new explicit Respond may replace only a failed, never-prepared model call.

	No timer or restart calls this to resend. Keep the old job until capture and
	page checks succeed; the new request then atomically replaces it.
	"""
	if (not isinstance(job, list) or len(job) < 7 or job[5] is not None or
		delivery_options(job).get('model_transport') != 'pi-socket-v1' or
		answers.get(job[1]) != 'failed' or job[1] in ready or
		job[1] in lesson_imports or not native_retry_safe(job)):
		return False
	try:
		with native_ink_runs.lock:
			native_ink_runs.require_unprepared(job[4])
	except (ValueError, OSError):
		return False
	return True


def native_retry_safe(job):
	if not job or len(job) < 7 or job[6] is not True:
		return False
	try:
		with open(live_baseline(job[1]) + ".native-attempt") as stream:
			attempt = stream.read(200).strip()
		return bool(re.fullmatch(r"notebook-[0-9a-f]{32}", attempt)) and attempt != job[4]
	except FileNotFoundError:
		return True
	except OSError:
		return False


def retry_notebook_response(request):
	"""Explicitly re-arm only a current, renderable, never-inserted held reply."""
	with pending_lock, native_ink_runs.lock:
		held = held_notebook_response(request)
		job = notebook_jobs[request]
		if answers.get(job[1]) not in ("ready", "revision-held") or not native_retry_safe(job):
			raise ValueError("insertion may already have started; inspect before retrying")
		from notebook_media import notebook_content
		if semantic_delivery(job):
			if not lesson_enabled(job[1].split('/')[0]):
				raise ValueError('native semantic replies are not enabled for this notebook')
			parse_semantic_reply(held['text'])
		elif has_lesson(held['text']):
			from notebook_lesson import parse_lesson
			if not lesson_enabled(job[1].split('/')[0]):
				raise ValueError('native lessons are not enabled for this notebook')
			parse_lesson(held['text'])  # complete validation, no source provisioning
		else:
			catalog = load_catalog(INK_CATALOG) if '[[notebook-ink:' in held['text'] else None
			notebook_content(held["text"], media_store, catalog)  # full formatting preflight, no tablet write
		if answers.get(job[1]) == 'revision-held':
			if not revision_pending(job) or pend('').get(job[1]) != job:
				raise ValueError('pending revision has changed')
			if time.time() - job[2] >= ANSWER_WAIT:
				raise ValueError('pending revision has expired')
			if job[1] in lesson_imports:
				raise ValueError('pending revision has an unexpected import')
			native_ink_runs.require_unprepared(request)
			job = with_delivery(job,revision_pending=None)
			pend(job[1], job)
			notebook_jobs[request] = job
			ready[job[1]] = held['text']
			answers[job[1]] = 'ready'
		retry_requests[request] = uuid.uuid4().hex
		return {"state": "ready", "request": request, "page": job[1], "retry_armed": True}


def held_notebook_response(request):
	"""Read one current held reply for formatting diagnosis; never insert/resend."""
	if not re.fullmatch(r"notebook-[0-9a-f]{32}", request):
		raise ValueError("exact notebook request ID required")
	with pending_lock:
		job = notebook_jobs.get(request)
		if not job or answer_status(job[1])["request"] != request:
			raise ValueError("request has no current held reply")
		if (answers.get(job[1]) == 'revision-held' and revision_pending(job) and
			pend('').get(job[1]) == job):
			return {"request": request, "page": job[1], "text": job[5]}
		if job[1] not in ready:
			raise ValueError("request has no current held reply")
		return {"request": request, "page": job[1], "text": ready[job[1]]}


def page_index(path):
	"""Return the notebook page index used by xochitl when reopening a page path."""
	try:
		doc, page = path[:-3].split("/")
		content = json.loads(tablet(f"cat {XOCHITL}/{doc}.content"))
		pages = sorted((item for item in content["cPages"]["pages"]
			if not item.get("deleted", {}).get("value")), key=lambda item: item["idx"]["value"])
		for index, item in enumerate(pages):
			if item.get("id") == page:
				return index
	except Exception:
		pass
	return None


def add_page(doc, content, like):
	"""A new last page for notebook doc (its .content), on page like's template: its id. The notebook must be closed."""
	pages = content["cPages"]["pages"]
	last = max(g["idx"]["value"] for g in pages)
	idx = last[:-1] + chr(ord(last[-1]) + 1) if last[-1] < "z" else last + "n"
	tpl = next((g.get("template") for g in pages if g["id"] == like), None) or {"timestamp": "1:1", "value": "Blank"}
	new = str(uuid.uuid4())
	pages.append({"id": new, "idx": {"timestamp": "1:2", "value": idx}, "template": dict(tpl)})
	content["pageCount"] = content.get("pageCount", 0) + 1
	tablet(f"cat > {XOCHITL}/{doc}.content.new && mv {XOCHITL}/{doc}.content.new {XOCHITL}/{doc}.content",
		json.dumps(content, indent=4).encode())
	return new


DRAWING = re.compile(r"```svg\s*(.*?)```", re.S)


def compose(text, top, size=36, bottom=1800):
	"""A desk's answer as pen strokes on the page from top: its words typed after a "> " prompt, and under them its
	drawing, if it sent one (an ```svg block of lines and curves), drawn to fit what is left of the page."""
	m = DRAWING.search(text)
	words = re.sub(r"[`*#_]+", "", DRAWING.sub(" ", text)).strip()
	lines, h = pen_text("> " + words, 1120, size, max_lines=max(1, int((bottom - top) // (size * 1.5)) - (8 if m else 0)),
		face=TYPE) if words else ([], 0)
	out = [[(-580 + x, top + y, 2.0) for x, y in l] for l in lines]
	if m:
		try:
			y0 = top + h + 30
			art, ah = svg_lines(m.group(1).strip(), 1000, max(200, bottom - y0))
			out += [[(-500 + x, y0 + y, 2.0) for x, y in l] for l in art]
		except Exception as e:
			print(time.strftime("%T"), "drawing not drawn:", e, file=sys.stderr)
	return out


def write_answer(path, text, keep=KEEP):
	if not re.fullmatch(r"[0-9a-f-]{36}/[0-9a-f-]{36}\.rm", path):
		raise ValueError("not a notebook page")
	first, end = None, time.time() + keep
	while first is None or time.time() < end:
		data = tablet(f"cat {XOCHITL}/{path}")
		ss = strokes(data)
		if first and any(p and abs(p[0][0] - first[0]) < 0.01 and abs(p[0][1] - first[1]) < 0.01 for _, p, _ in ss):
			time.sleep(60)   # still there
			continue
		top = max([y for _, p, _ in ss for _, y, _ in p] or [60]) + 90
		size = 36
		room = int((1800 - top) // (size * 1.5))
		if room < 3 or (DRAWING.search(text) and 1800 - top < 600):   # onto the next page, a fresh one if it has nothing on it yet
			doc, page = path[:-3].split("/")
			content = json.loads(tablet(f"cat {XOCHITL}/{doc}.content"))
			order = [g["id"] for g in content["cPages"]["pages"] if not g.get("deleted", {}).get("value")]
			after = order[order.index(page) + 1:] if page in order else []
			if not after:   # the notebook's last page: a new one after it, on the same template
				after = [add_page(doc, content, page)]
			nxt = f"{doc}/{after[0]}.rm"
			if not strokes(tablet(f"cat {XOCHITL}/{nxt} 2>/dev/null")):
				fresh, start = blank(data)
				lines = compose(text, 150)
				tablet(f"cat > {XOCHITL}/{nxt}.new && mv {XOCHITL}/{nxt}.new {XOCHITL}/{nxt}", append(fresh, lines, start))
				answers[path] = answers[nxt] = "written"
				print(time.strftime("%T"), "answer written on a fresh page", nxt, len(lines), "strokes", file=sys.stderr)
				return nxt
			return write_answer(nxt, text, keep)
		lines = compose(text, top)
		first = lines[0][0][:2]
		tablet(f"cat > {XOCHITL}/{path}.new && mv {XOCHITL}/{path}.new {XOCHITL}/{path}", append(data, lines))
		answers[path] = "written"
		print(time.strftime("%T"), "answer written", path, len(lines), "strokes", file=sys.stderr)
		if keep:
			time.sleep(60)
	return path


# --- correspondence: one desk's conversation, for the tablet

threads = {}   # transcript path -> ((mtime, size), items)


def para(t):
	"""clean(), keeping the paragraphs: the tablet shows a reply as it was written."""
	t = re.sub(r"<([a-z-]+)[^>]*>.*?</\1>", " ", t, flags=re.S).replace("**", "").replace("`", "")
	lines = (" ".join(re.sub(r"^\s*#+\s*", "", l).split()) for l in t.splitlines())
	return "\n".join(l for l in lines if l)


def turns(sid):
	"""The last THREAD turns of session sid: each thing the owner said, and the last thing the agent wrote after it."""
	path = transcript(sid)
	if not path:
		return []
	key = (os.path.getmtime(path), os.path.getsize(path))
	if threads.get(path, (None,))[0] == key:
		return threads[path][1]
	with open(path, "rb") as f:
		f.seek(max(0, key[1] - 3_000_000))
		lines = f.read().splitlines()
	items = []
	for line in lines:
		if b'"timestamp"' not in line or (b'"type":"user"' not in line and b'"type":"assistant"' not in line):
			continue
		try:
			e = json.loads(line)
			t = int(datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp())
		except (ValueError, KeyError):
			continue
		if e.get("type") not in ("user", "assistant") or e.get("isMeta") or e.get("isCompactSummary"):
			continue
		raw = text_of(e.get("message", {}).get("content", ""))
		text = para(raw)
		art = re.search(r"<svg\b.*?</svg>", raw, re.S) if e["type"] == "assistant" else None
		if not text or text.startswith(("[Request interrupted", "This session is being continued")):
			continue
		who = "you" if e["type"] == "user" else "agent"
		if who == "agent" and items and items[-1]["who"] == "agent":
			items.pop()   # a turn's narration on the way: only its last word stands
		items.append({"who": who, "text": text if len(text) <= REPLY else text[:REPLY].rsplit(" ", 1)[0] + "…", "at": t})
		if art:
			items[-1]["svg"] = art.group(0)
	starts = [i for i, it in enumerate(items) if it["who"] == "you"]
	items = items[starts[-THREAD]:] if len(starts) >= THREAD else items
	threads[path] = (key, items)
	return items


def thread(pane):
	desks, me = [], None
	for a in agent_list():
		d = {"name": a.get("name") or a.get("agent", "?"), "pane": a.get("pane_id"), "status": a.get("agent_status", "?")}
		desks.append(d)
		if d["pane"] == pane:
			s = a.get("agent_session") or {}
			me = dict(d, runtime=a.get("agent"), session=s,
				sid=s["value"] if a.get("agent") == "claude" and s.get("kind") == "id" else None)
	desks.sort(key=lambda d: (ORDER.get(d["status"], 4), d["name"]))
	if me and me["sid"]:
		items = turns(me["sid"])
	elif me:   # no transcript to read (not Claude Code): what was written to it from here
		items = [{"who": "you", "text": l["text"], "at": l["at"]} for l in letters if l["name"] == me["name"]][-THREAD:]
	else:
		items = []
	out = {"desks": desks, "name": me["name"] if me else "", "status": me["status"] if me else "", "items": items}
	if me:
		out.update(runtime=me["runtime"], session=me["session"])
	out["v"] = hashlib.sha1(json.dumps(out).encode()).hexdigest()[:12]
	return out


# --- the walk edition: a voice session on the R1, from herd-voice's trace and the agents' transcripts

def walk_list():
	"""The last WALKS walks, newest first: runs of what the R1 was told with no WALK_GAP of quiet."""
	runs = []
	for path in (TRACE + ".1", TRACE):
		try:
			lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
		except OSError:
			continue
		for line in lines:
			m = re.match(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) (say|progress|cue) (.*)", line)
			if not m:
				continue
			t = datetime.strptime(m[1], "%Y-%m-%d %H:%M:%S").timestamp()
			if not runs or t - runs[-1]["end"] > WALK_GAP:
				runs.append({"start": t, "end": t, "told": []})
			runs[-1]["end"] = t
			if m[2] == "say" or not runs[-1]["told"] or runs[-1]["told"][-1][2] != m[3]:
				runs[-1]["told"].append((t, m[2], m[3].strip()))
	return [r for r in reversed(runs) if len(r["told"]) >= 2][:WALKS]


def asked(start, end):
	"""What the owner said to each Claude agent between start and end (on a walk: by voice), from its transcript."""
	out = []
	for a in agent_list():
		s = a.get("agent_session") or {}
		path = transcript(s["value"]) if a.get("agent") == "claude" and s.get("kind") == "id" else None
		if not path or os.path.getmtime(path) < start:
			continue
		with open(path, "rb") as f:
			f.seek(max(0, os.path.getsize(path) - 3_000_000))
			for line in f:
				if b'"type":"user"' not in line or b'"timestamp"' not in line:
					continue
				try:
					e = json.loads(line)
					t = datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
				except (ValueError, KeyError):
					continue
				text = clean(text_of(e.get("message", {}).get("content", "")))
				if start - 60 <= t <= end and text and not text.startswith("[Request interrupted"):
					out.append((t, a.get("name") or a.get("agent", "?"), short(text, 400)))
	return sorted(out)


def write_walk(w):
	old = walks.get(int(w["start"]))
	live = time.time() - w["end"] < WALK_GAP
	if held() or (old and (len(w["told"]) == old["n"] or not live or time.time() - old["t"] < WRITE)):
		return False
	if time.time() - tried.get(("walk", int(w["start"])), 0) < WRITE:
		return False
	tried[("walk", int(w["start"]))] = time.time()
	log = [(t, f"James to {name}: {x}") for t, name, x in asked(w["start"], w["end"])]
	log += [(t, f"read back: {x}" if kind == "say" else f"(while it worked) {x}") for t, kind, x in w["told"]]
	text = "\n".join(f"{datetime.fromtimestamp(t):%H:%M} {x}" for t, x in sorted(log))
	e = gemini(WALK_SYS, f"The walk: {datetime.fromtimestamp(w['start']):%A %d %B, %H:%M} to "
		f"{datetime.fromtimestamp(w['end']):%H:%M}\n\nLog:\n{text[-LOG:]}")
	walks[int(w["start"])] = {"headline": str(e.get("headline", "")), "lede": str(e.get("lede", "")),
		"decisions": [str(d) for d in e.get("decisions", [])][:5], "n": len(w["told"]), "t": time.time()}
	with open(f"{CACHE}/walks.json", "w") as f:
		json.dump({str(k): v for k, v in walks.items()}, f)
	return True


def walk_json():
	out = []
	for w in walk_list():
		e = walks.get(int(w["start"]))
		said_back = [x for t, kind, x in w["told"] if kind == "say"]
		out.append({"start": int(w["start"]), "end": int(w["end"]), "said": len(said_back),
			"live": time.time() - w["end"] < WALK_GAP,
			"asked": [{"at": int(t), "to": n, "text": x} for t, n, x in asked(w["start"], w["end"])][-8:],
			"told": [short(x, 300) for x in said_back][-8:],
			"edition": {k: e[k] for k in ("headline", "lede", "decisions")} if e else None})
	return {"walks": out, "tz": tz()}


# --- the R1's instruments, and this host's Gemini ledger

R1_READ = r"""b=/sys/class/power_supply/battery
echo "cap=$(cat $b/capacity)"; echo "state=$(cat $b/status)"; echo "mv=$(( $(cat $b/voltage_now) / 1000 ))"
echo "ma=$(( $(cat $b/current_now 2>/dev/null || echo 0) / 1000 ))"
[ -f /run/r1-net ] && { echo "netage=$(( $(date +%s) - $(stat -c %Y /run/r1-net) ))"; grep -E '^(lte|dbm)=' /run/r1-net; }
echo "wifi=$(cat /sys/class/net/wlan0/operstate 2>/dev/null)"; awk 'NR==3{print "wdbm=" int($4)}' /proc/net/wireless
ls /sys/class/bluetooth | grep -q : && echo bt=1 || echo bt=0
ip -4 addr show tailscale0 2>/dev/null | grep -q inet && echo ts=1 || echo ts=0
echo "up=$(cut -d. -f1 /proc/uptime)"; echo "load=$(cut -d' ' -f1 /proc/loadavg)"
"""


def r1_state():
	"""The R1's battery and links, read over ssh at most every R1_EVERY seconds: numbers and states only, no
	identifiers (from r1-net, only lte and dbm)."""
	if time.time() - r1["t"] < R1_EVERY:
		return r1["s"]
	r1["t"] = time.time()
	try:
		r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", R1, "sh"], input=R1_READ,
			capture_output=True, text=True, timeout=15, env={**os.environ, "SSH_AUTH_SOCK": R1_SOCK})
		kv = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
	except (OSError, subprocess.SubprocessError):
		kv = {}
	num = lambda k: int(kv[k]) if re.fullmatch(r"-?\d+", kv.get(k, "")) else None
	if not kv:
		r1["s"] = {"online": False, "seen": r1["s"].get("seen")}
		return r1["s"]
	w = num("wdbm")
	lte = kv.get("lte", "off") if (num("netage") or 999) < 90 else "off"
	r1["s"] = {"online": True, "seen": int(time.time()), "battery": num("cap"), "charging": kv.get("state") == "Charging",
		"state": kv.get("state", ""), "mv": num("mv"), "ma": num("ma"), "lte": lte, "lte_dbm": num("dbm"),
		"wifi": kv.get("wifi") == "up", "wifi_dbm": (w - 256 if w and w > 63 else w), "bt": kv.get("bt") == "1",
		"tailscale": kv.get("ts") == "1", "uptime": num("up"), "load": kv.get("load")}
	return r1["s"]


def gemini_today():
	day, callers, n429 = time.strftime("%Y-%m-%d"), {}, 0
	try:
		for line in open(f"{GEMINI}/calls.log", encoding="utf-8", errors="replace"):
			f = line.split()
			if len(f) < 5 or f[0] != day:
				continue
			who = f[2].split(":")[0]
			c = callers.setdefault(who, {"calls": 0, "tokens": 0})
			c["calls"] += 1
			c["tokens"] += sum(int(x.split("=")[1]) for x in f if re.fullmatch(r"(in|out|think)=\d+", x))
			n429 += f[4] == "429"
	except OSError:
		pass
	try:
		hold = max(0, int(float(open(f"{GEMINI}/hold-until").read()) - time.time()))
	except (OSError, ValueError):
		hold = 0
	return {"callers": callers, "limited": n429, "hold": hold}


# --- field dispatches: the R1 recorder's notes

def dispatch_list():
	out = []
	for path in sorted(glob.glob(f"{RECORDINGS}/*.md"), reverse=True)[:12]:
		try:
			t = open(path, encoding="utf-8", errors="replace").read()
		except OSError:
			continue
		title = re.search(r"^# (.+)$", t, re.M)
		meta = re.search(r"^\*(.+)\*$", t, re.M)
		summary = re.search(r"## Summary\s*\n(.*?)(?:\n## |\Z)", t, re.S)
		body = re.search(r"## Transcript\s*\n(.*)", t, re.S)
		out.append({"file": os.path.basename(path), "title": title[1].strip() if title else os.path.basename(path),
			"meta": meta[1].strip() if meta else "",
			"summary": " ".join(l.lstrip("- ").strip() for l in (summary[1] if summary else "").splitlines() if l.strip()),
			"transcript": short(" ".join((body[1] if body else "").split()), 1500)})
	return out


def hand(pane, file):
	"""A dispatch to a desk: its title and summary into the agent's pane, with where the full note is."""
	d = next((d for d in dispatch_list() if d["file"] == file), None)
	if not d:
		raise ValueError("no such dispatch")
	return send(pane, f"A field dispatch recorded on the R1, for you to act on: {d['title']}. {d['summary']} "
		f"The full note and transcript: {RECORDINGS}/{file}")



def strike(file):
	"""A dispatch struck out on the tablet: its note and recording into RECORDINGS/.deleted, not gone, in case the
	cross was a slip."""
	if file not in {d["file"] for d in dispatch_list()}:
		raise ValueError("no such dispatch")
	os.makedirs(f"{RECORDINGS}/.deleted", exist_ok=True)
	stem = file[:-len(".md")]
	for path in glob.glob(f"{RECORDINGS}/{glob.escape(stem)}.*"):
		os.replace(path, f"{RECORDINGS}/.deleted/{os.path.basename(path)}")
	return file

class Handler(BaseHTTPRequestHandler):
	def notebook_authorized(self, method, path):
		if not protected_route(path):
			return True
		status = notebook_auth.rejection(method, path, self.headers) if notebook_auth else 503
		if status is None:
			return True
		print(f"{time.strftime('%H:%M:%S')} {method} {path}: refused {status}", file=sys.stderr, flush=True)
		self.reply(status, {"error": "Notebook caller not authorized"})
		return False

	def reply(self, code, obj):
		body = json.dumps(obj).encode()
		self.send_response(code)
		self.send_header("Content-Type", "application/json")
		self.send_header("Content-Length", str(len(body)))
		self.end_headers()
		self.wfile.write(body)

	def do_GET(self):
		path, _, query = self.path.partition("?")
		if not self.notebook_authorized("GET", path):
			return
		try:
			if path == "/notebook-device-context":
				self.reply(200, device_context.snapshot())
			elif path == "/notebook-native-probe":
				self.reply(200, native_probe.snapshot())
			elif path == "/notebook-status":
				self.reply(200, {"jobs": [{"request": marker, "page": job[1],
					"state": answers.get(job[1], "unknown"), "error": reply_errors.get(job[1]),
					"source_found": marker in reply_reader.sources, "timing_ms": timing_status(job[1])}
					for marker, job in list(notebook_jobs.items())],
					"transcript_roots": reply_reader.inventory()})
			elif path == "/answer":
				pg = urllib.parse.parse_qs(query).get("page", [""])[0]
				self.reply(200, answer_status(pg))
			elif path == "/notebook-response":
				request = urllib.parse.parse_qs(query).get("request", [""])[0]
				self.reply(200, held_notebook_response(request))
			elif path == "/herd.json":
				since = dict(q.split("=", 1) for q in query.split("&") if "=" in q).get("since")
				h, end = herd(), time.time() + HOLD
				while since and h["v"] == since and time.time() < end:
					time.sleep(POLL)
					h = herd()
				for a in h["agents"]:
					a.pop("sid")
				self.reply(200, h)
			elif path == "/thread.json":
				q = dict(urllib.parse.parse_qsl(query))
				t, end = thread(q.get("pane", "")), time.time() + HOLD
				while q.get("since") and t["v"] == q["since"] and time.time() < end:
					time.sleep(POLL)
					t = thread(q.get("pane", ""))
				self.reply(200, t)
			elif path == "/walk.json":
				self.reply(200, walk_json())
			elif path == "/r1.json":
				self.reply(200, {"r1": r1_state(), "gemini": gemini_today(), "at": int(time.time()), "tz": tz()})
			elif path == "/dispatches.json":
				self.reply(200, {"dispatches": dispatch_list(),
					"desks": [{"name": a.get("name") or a.get("agent", "?"), "pane": a.get("pane_id")} for a in agent_list()]})
			else:
				self.send_error(404)
		except Exception as e:
			self.reply(500, {"error": str(e)})

	def do_POST(self):
		"""POST /read {"pane"} (its notebook's latest page) or {"png": base64 or a data: URL} -> {"text"}; /send {"pane", "text"} and /hand {"pane", "file"}
		-> {"to": the desk's name}; /strike {"file"}
		-> {"struck"}: a dispatch into RECORDINGS/.deleted; /restart: exit, and launchd starts the server again."""
		if not self.notebook_authorized("POST", self.path.partition("?")[0]):
			return  # Authenticate before reading a body or invoking any side effect.
		try:
			n = int(self.headers.get("Content-Length", 0))
			if n > 4_000_000:
				raise ValueError("too large")
			q = json.loads(self.rfile.read(n) or b"{}")
			traced = self.path in TRACED_POSTS and isinstance(q, dict)
			if self.path == "/notebook-test":
				self.reply(200, arm_notebook_test(q))
			elif self.path == "/read" and q.get("pane"):
				self.reply(200, {"text": read_page(str(q["pane"]))})
			elif self.path == "/read":
				png = str(q.get("png", "")).split(",", 1)[-1]
				base64.b64decode(png, validate=True)
				self.reply(200, {"text": read_letter(png)})
			elif self.path == "/notebook-reply":
				self.reply(200, notebook_reply(str(q.get("request", "")), q.get("text")))
			elif self.path == "/notebook-primer-prestart":
				self.reply(200, primer_prestart(q))
			elif self.path == "/notebook-retry":
				self.reply(200, retry_notebook_response(str(q.get("request", ""))))
			elif self.path == "/notebook-revise":
				self.reply(200, revise_notebook_response(str(q.get("request", "")), q.get("expected_sha256"), q.get("text")))
			elif self.path == "/notebook-media":
				if "equation" in q:
					asset = media_store.equation(q["equation"])
				else:
					data = base64.b64decode(str(q.get("png", "")), validate=True)
					asset = media_store.put(data, str(q.get("kind", "photo")))
				self.reply(200, asset)
			elif self.path == "/notebook-media-test":
				doc, page, asset = str(q.get("doc", "")), str(q.get("page", "")), str(q.get("asset", ""))
				if not re.fullmatch(r"[0-9a-f-]{36}", doc) or not re.fullmatch(r"[0-9a-f-]{36}", page):
					raise ValueError("media test requires notebook and page UUIDs")
				media_store.get(asset)  # validates ID and local image integrity
				with pending_lock:
					media_tests[f"{doc}/{page}.rm"] = {"asset": asset, "expires": time.time() + 300}
				self.reply(200, {"armed": True, "expires_in": 300})
			elif self.path == "/write":
				self.reply(200, write_ready(str(q.get("page", ""))))
			elif self.path == "/write-live":
				self.reply(200, write_live(str(q.get("page", ""))))
			elif self.path == "/native-context":
				self.reply(200, native_context_report(q))
			elif self.path == "/notebook-keep-awake":
				self.reply(200, device_context.keep_awake(q))
			elif self.path == "/notebook-audit-view":
				self.reply(200, arm_view_audit(q))
			elif self.path == "/notebook-native-probe":
				self.reply(200, arm_native_probe(q))
			elif self.path == "/native-probe-claim":
				self.reply(200, claim_native_probe(q))
			elif self.path == "/native-probe-result":
				self.reply(200, complete_native_probe(q))
			elif self.path == "/native-text":
				self.reply(200, native_text(str(q.get("page", "")), ink_supported=type(q.get("ink_version")) is int and q["ink_version"] == 1, imported=q.get('imported'), import_supported=type(q.get('lesson_version')) is int and q['lesson_version'] == 1,
					preservation_supported=type(q.get('preservation_version')) is int and q['preservation_version'] == 1, layout=q.get('layout'),
					reveal_supported=type(q.get('reveal_version')) is int and q['reveal_version'] == 1,
					playback_supported=type(q.get('playback_version')) is int and q['playback_version'] == 1,
					pen_equations_supported=type(q.get('pen_equations_version')) is int and q['pen_equations_version'] == 1,
					story_supported=type(q.get('story_version')) is int and q['story_version'] == 1,
					hand_supported=type(q.get('hand_version')) is int and q['hand_version'] == 1))
			elif self.path == "/native-ink-claim":
				self.reply(200, claim_native_ink(q))
			elif self.path == "/native-ink-done":
				self.reply(200, complete_native_ink(q))
			elif self.path == "/notebook-ink-proof":
				self.reply(200, native_ink_proof(str(q.get("request", "")), q.get('layout')))
			elif self.path == "/native-text-done":
				self.reply(200, native_text(str(q.get("page", "")), str(q.get("request", "")), done=True))
			elif self.path == "/native-text-failed":
				self.reply(200, native_text_failed(str(q.get("page", "")), str(q.get("request", ""))))
			elif self.path == "/notebook-media-proof":
				self.reply(200, native_media_proof(str(q.get("page", "")), str(q.get("request", "")), q.get("assets")))
			elif self.path == "/respond":
				self.reply(200, respond(str(q.get("doc", "")), str(q.get("page", "")), q.get("live") is True, q.get("supersedes", ""),
					stream_supported=type(q.get('answer_stream_version')) is int and q['answer_stream_version'] == 1))
			elif self.path == "/notebook-answer-stream":
				self.reply(200, notebook_answer_stream(q))
			elif self.path == "/send":
				self.reply(200, {"to": post_letter(str(q.get("pane", "")), str(q.get("text", "")))})
			elif self.path == "/hand":
				self.reply(200, {"to": hand(str(q.get("pane", "")), str(q.get("file", "")))})
			elif self.path == "/strike":
				self.reply(200, {"struck": strike(str(q.get("file", "")))})
			elif self.path == "/restart":   # launchd (KeepAlive) starts it again, with its code as it is now
				self.reply(200, {"restarting": True})
				print(f"{time.strftime('%H:%M:%S')} restart asked for", file=sys.stderr, flush=True)
				threading.Timer(0.5, os._exit, (0,)).start()
			else:
				self.send_error(404)
		except Exception as e:
			if traced:
				trace.event(TRACED_POSTS[self.path], 'failed', request=str(q.get('request') or '') or None,
					path=str(q.get('page') or '') or None, reason=f'{type(e).__name__}: {e}')
			print(f"{time.strftime('%H:%M:%S')} POST {self.path}: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
			self.reply(400 if isinstance(e, ValueError) else 500, {"error": str(e)})

	def log_message(self, *a):
		pass


# The native endpoints the tablet calls after a Respond, and the stage each one is: a failure there is traced.
TRACED_POSTS = {'/native-text': 'placed', '/native-text-done': 'acknowledged', '/native-text-failed': 'written',
	'/native-ink-claim': 'written', '/native-ink-done': 'written', '/notebook-ink-proof': 'written',
	'/notebook-media-proof': 'written', '/write-live': 'written'}


