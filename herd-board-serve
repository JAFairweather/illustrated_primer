# herd-board-primer's spoken question, asked while its pen writes it: page path -> the answer on its way.
primer_prestarts, PRESTART_KEEP = {}, 120  # seconds a prestarted answer waits for its press


def primer_prestart(q):
	"""Start the model on the page as Respond will capture it once the pen has written: the live screen with the
	question's strokes drawn where they will go. The press still makes every check and uses this answer only for
	its first attempt. {"doc", "page", "strokes": [[[x, y], ...], ...]} or {"doc", "page", "cancel": true}
	"replay": a kept reply's request id answers with that reply again instead of the model, to film a lesson again.
	"question": the question's text, which is looked up for current facts before the model is asked."""
	doc, page = str(q.get('doc', '')), str(q.get('page', ''))
	replay, question = q.get('replay'), q.get('question')
	if question is not None and not (isinstance(question, str) and 0 < len(question) <= 300):
		raise ValueError('question must be 1 to 300 characters')
	if replay is not None and not (isinstance(replay, str) and re.fullmatch(r'notebook-[0-9a-f]{32}', replay) and
			os.path.isfile(os.path.join(CACHE, 'replies', replay+'.json'))):
		raise ValueError('replay needs a kept reply')
	if not re.fullmatch(r"[0-9a-f-]{36}", doc) or not re.fullmatch(r"[0-9a-f-]{36}", page):
		raise ValueError('prestart requires notebook and page UUIDs')
	path = f"{doc}/{page}.rm"
	if q.get('cancel') is True:
		with pending_lock:
			entry = primer_prestarts.pop(path, None)
		if entry:
			entry['current'] = lambda: False
		trace.event('primer', 'prestart cancelled', path=path, found=bool(entry))
		return {'cancelled': bool(entry)}
	strokes = q.get('strokes')
	if (not isinstance(strokes, list) or not 0 < len(strokes) <= 3000 or sum(map(len, strokes)) > 60000 or
		any(not s or any(not isinstance(p, list) or len(p) != 2 or
			any(type(n) not in (int, float) or not 0 <= n < 1872 for n in p) for p in s) for s in strokes)):
		raise ValueError('prestart strokes out of bounds')
	m = re.search(rb'"visibleName": "[Tt]o ([^"]+)"', tablet(f"cat {XOCHITL}/{doc}.metadata"))
	route = notebook_model_route(doc, m.group(1).decode() if m else '', True)
	if not route or route.get('response_format') in ('story-panel-v1', 'story-stream-v1', 'role-production-v1'):
		raise ValueError('prestart needs the lesson model route')
	context = device_context.snapshot()
	if context.get('doc') != doc or context.get('page') != page or not model_page_current(context):
		raise ValueError('prestart requires the unchanged active page')
	from PIL import Image, ImageDraw
	frame = live_capture(tablet).convert('L')
	draw = ImageDraw.Draw(frame)
	for s in strokes:
		draw.line([tuple(p) for p in s] if len(s) > 1 else [tuple(s[0])]*2, fill=0, width=4)
	baseline = None
	if os.path.isfile(live_baseline(path)):
		with Image.open(live_baseline(path)) as saved:
			baseline = saved.convert('L')
	crop, image_context = notebook_visual_input(frame, baseline)
	if crop is None:
		raise ValueError('prestart found no question on the page')
	png, image_context = live_png(crop), lesson_notes(image_context, path)
	entry = {'t': time.time(), 'done': threading.Event(), 'result': None, 'observed': None, 'error': None,
		'current': lambda: True}
	def run():
		def observe(raw):
			entry['observed'] = raw
		request = 'notebook-'+os.urandom(16).hex()
		context = image_context
		try:
			if not replay and not waiting_send(path):  # a yes or no needs no tale and no web search
				context = with_story(context, png, question, request, path)
			entry['context'] = context  # a retry after a refused answer keeps the facts
			if replay:
				with open(os.path.join(CACHE, 'replies', replay+'.json')) as f:
					kept = dict(json.load(f), request_id=request)
				entry['result'] = validate_model_result(json.dumps(kept).encode(), request, observe_response=observe)
				replay_picture(replay, entry['result'], request, path)
			else:
				entry['result'] = call_notebook_model(route['socket'], request, png, context,
					deadline_ms=route['deadline_ms'], is_current=lambda: entry['current'](), observe_response=observe)
		except Exception as error:
			entry['error'] = error
		finally:
			entry['done'].set()
	with pending_lock:
		old = primer_prestarts.pop(path, None)
		if old:
			old['current'] = lambda: False
		primer_prestarts[path] = entry
	threading.Thread(target=run, daemon=True).start()
	trace.event('primer', 'prestarted', path=path, png_bytes=len(png), replay=replay)
	return {'prestarted': True}


