def agent_list():
	r = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, timeout=10)
	return json.loads(r.stdout)["result"]["agents"]


def transcript(sid):
	p = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sid}.jsonl"))
	return p[0] if p else None


def said(sid):
	path = transcript(sid)
	if not path:
		return ""
	key = (os.path.getmtime(path), os.path.getsize(path))
	if cache.get(sid, (None,))[0] == key:
		return cache[sid][1]
	cache[sid] = (key, last_text(path))
	return cache[sid][1]


def last_text(path):
	with open(path, "rb") as f:
		f.seek(max(0, os.path.getsize(path) - 400_000))
		lines = f.read().splitlines()
	for line in reversed(lines):
		try:
			e = json.loads(line)
		except ValueError:
			continue
		if e.get("type") != "assistant":
			continue
		text = " ".join(b.get("text", "") for b in e.get("message", {}).get("content", [])
			if isinstance(b, dict) and b.get("type") == "text").strip()
		if text:
			text = " ".join(text.replace("**", "").replace("`", "").split())
			return text if len(text) <= SAID else text[:SAID].rsplit(" ", 1)[0] + "…"
	return ""


def herd():
	agents, (edition, day) = [], edition_day()
	for a in agent_list():
		s = a.get("agent_session") or {}
		sid = s["value"] if a.get("agent") == "claude" and s.get("kind") == "id" else None
		sec = sections.get((sid, day))
		agents.append({
			"name": a.get("name") or a.get("agent", "?"),
			"status": a.get("agent_status", "?"),
			"task": a.get("terminal_title_stripped", ""),
			"said": said(sid) if sid else "",
			"section": {"headline": sec["headline"], "body": sec["body"]} if sec else None,
			"recent": recent(sid) if sid else [],
			"letters": [{"at": l["at"], "text": l["text"]} for l in letters
				if l["name"] == (a.get("name") or a.get("agent")) and l["at"] >= time.time() - 86400][-2:],
			"pane": a.get("pane_id"),
			"sid": sid,
		})
	agents.sort(key=lambda a: (ORDER.get(a["status"], 4), a["section"] is None, a["name"]))
	v = hashlib.sha1(json.dumps([edition, agents]).encode()).hexdigest()[:12]
	with lock:
		if v != last["v"]:
			last.update(v=v, at=int(time.time()))
		return {"v": v, "at": last["at"], "tz": tz(), "edition": edition, "day": day, "agents": agents}


def recent(sid):
	"""The last RECENT exchanges: each thing the owner asked, and the last thing the agent wrote before the next."""
	ex = []
	for t, who, text in logs.get(sid, {}).get("items", []):
		if who == "James":
			ex.append({"asked": short(text, 300), "replied": ""})
		elif ex:
			ex[-1]["replied"] = short(text, 600)
	return ex[-RECENT:]


def tz():
	"""This Mac's offset from UTC in seconds, for the tablet, which keeps UTC."""
	return int(datetime.now().astimezone().utcoffset().total_seconds())


def short(t, n):
	return t if len(t) <= n else t[:n].rsplit(" ", 1)[0] + "…"


def edition_day():
	now = datetime.now()
	if now.hour < 12:
		return "Morning", (now - timedelta(days=1)).strftime("%Y-%m-%d")
	return ("Afternoon" if now.hour < 17 else "Evening"), now.strftime("%Y-%m-%d")


# --- the sections

def text_of(content):
	if isinstance(content, str):
		return content
	return " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")


def clean(t):
	t = re.sub(r"<([a-z-]+)[^>]*>.*?</\1>", " ", t, flags=re.S)   # system reminders, pasted blocks, command tags
	return " ".join(t.replace("**", "").replace("`", "").split())


def read_log(sid, since):
	"""What the owner asked and the agent wrote in session sid since epoch since, read on from where we stopped."""
	path = transcript(sid)
	if not path:
		return []
	lg = logs.setdefault(sid, {"off": 0, "items": []})
	with open(path, "rb") as f:
		f.seek(lg["off"])
		for line in f:
			if not line.endswith(b"\n"):
				break
			lg["off"] += len(line)
			if b'"timestamp"' not in line or (b'"type":"user"' not in line and b'"type":"assistant"' not in line):
				continue
			try:
				e = json.loads(line)
				t = datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
			except (ValueError, KeyError):
				continue
			if t < since or e.get("type") not in ("user", "assistant"):
				continue
			text = clean(text_of(e.get("message", {}).get("content", "")))
			if text and not text.startswith("[Request interrupted"):
				lg["items"].append((t, "James" if e["type"] == "user" else "agent", text[:700]))
	lg["items"] = [i for i in lg["items"] if i[0] >= since]
	return lg["items"]


def held():
	try:
		return float(open(f"{GEMINI}/hold-until").read()) > time.time()
	except (OSError, ValueError):
		return False


def ledger(status, usage, start, hold=0):
	u = usage or {}
	try:
		os.makedirs(GEMINI, exist_ok=True)
		if hold:
			with open(f"{GEMINI}/hold-until", "w") as f:
				f.write(str(time.time() + hold))
		with open(f"{GEMINI}/calls.log", "a") as f:
			f.write(f"{time.strftime('%F %T')} herd-board {MODEL} {status} in={u.get('promptTokenCount', 0)} "
				f"cached={u.get('cachedContentTokenCount', 0)} out={u.get('candidatesTokenCount', 0)} "
				f"think={u.get('thoughtsTokenCount', 0)} {time.time() - start:.2f}s{f' hold={hold:g}s' if hold else ''}\n")
	except OSError:
		pass


def gemini(system, text, png=None, _json_retry=False):
	"""Gemini's JSON answer to text, and with png (base64) that image too."""
	parts = [{"text": text}] + ([{"inline_data": {"mime_type": "image/png", "data": png}}] if png else [])
	config = {"maxOutputTokens": 700, "temperature": 0.4, "responseMimeType": "application/json",
		"thinkingConfig": {"thinkingLevel": "minimal"}}
	if png is not None:
		config["responseSchema"] = {"type": "OBJECT", "properties": {"text": {"type": "STRING"}}, "required": ["text"]}
		system += " Use literal Unicode math and linear notation, never TeX backslash commands."
	body = json.dumps({"systemInstruction": {"parts": [{"text": system}]},
		"contents": [{"role": "user", "parts": parts}],
		"generationConfig": config}).encode()
	with open(KEYF) as credential:
		api_key = credential.read().strip()
	req = urllib.request.Request(f"https://generativelanguage.googleapis.com/v1beta/models/{MODEL}:generateContent",
		data=body, headers={"content-type": "application/json", "x-goog-api-key": api_key})
	start = time.time()
	try:
		with urllib.request.urlopen(req, timeout=40) as r:
			d = json.load(r)
	except urllib.error.HTTPError as e:
		hold = 0
		if e.code == 429:   # its retry delay, else a minute
			try:
				hold = float(next(x["retryDelay"] for x in json.loads(e.read())["error"]["details"] if "retryDelay" in x).rstrip("s"))
			except (OSError, ValueError, KeyError, TypeError, StopIteration):
				hold = 60
		ledger(e.code, None, start, hold)
		raise
	except OSError as e:
		ledger(type(e).__name__, None, start)
		raise
	ledger(200, d.get("usageMetadata"), start)
	c = (d.get("candidates") or [{}])[0]
	try:
		result = json.loads("".join(p.get("text", "") for p in c.get("content", {}).get("parts", [])))
		if png is not None and (not isinstance(result, dict) or set(result) != {"text"} or not isinstance(result["text"], str)):
			raise ValueError("invalid handwriting reader response")
		return result
	except (ValueError, TypeError):
		if png is not None and not _json_retry:
			# Retry the image read once, BEFORE creating/sending an agent request.
			# Never repair escape sequences by guessing the intended mathematics.
			return gemini(system + " Return one valid JSON object containing only a text string.", text, png, _json_retry=True)
		raise ValueError("Could not read the handwriting safely; your writing is unchanged") from None


def write(name, sid, day):
	start = datetime.strptime(day, "%Y-%m-%d").timestamp()
	items = [i for i in read_log(sid, start) if i[0] < start + 86400]
	old = sections.get((sid, day))
	today = day == datetime.now().strftime("%Y-%m-%d")
	if not items or held() or (old and (len(items) == old["n"] or not today or time.time() - old["t"] < WRITE)):
		return False
	if time.time() - tried.get((sid, day), 0) < WRITE:
		return False
	tried[(sid, day)] = time.time()
	log = "\n".join(f"{datetime.fromtimestamp(t):%H:%M} {name if who == 'agent' else who}: {x}" for t, who, x in items)
	s = gemini(SECTION_SYS, f"Agent: {name}\nDay: {day}\n\nLog:\n{log if len(log) <= LOG else log[-LOG:]}")
	sections[(sid, day)] = {"headline": str(s["headline"]), "body": str(s["body"]), "n": len(items), "t": time.time()}
	with open(f"{CACHE}/sections.json", "w") as f:
		json.dump([[k[0], k[1], v] for k, v in sections.items()], f)
	return True


def writer():
	while True:
		try:
			_, day = edition_day()
			for a in herd()["agents"]:
				if a["sid"]:
					try:
						if write(a["name"], a["sid"], day):
							time.sleep(5)   # the key is rate limited
					except Exception as e:
						print(f"herd-board-serve: no section for {a['name']}: {type(e).__name__}: {e}", file=sys.stderr)
			for w in walk_list():
				try:
					if write_walk(w):
						time.sleep(5)
				except Exception as e:
					print(f"herd-board-serve: no walk edition: {type(e).__name__}: {e}", file=sys.stderr)
		except Exception as e:
			print(f"herd-board-serve: writer: {type(e).__name__}: {e}", file=sys.stderr)
		time.sleep(60)


# --- letters: the owner's handwriting, read by Gemini, sent to a desk

def numeric_read_signature(text):
	"""Compare literal numbers across ordinary OCR spelling/notation variants.

	Do not solve or infer a missing value. Compound number words deliberately
	remain conservative; this only canonicalizes explicit small numbers/powers.
	"""
	words = 'zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen'.split()
	values = {word: str(i) for i, word in enumerate(words)}
	text = re.sub(r'\b(?:' + '|'.join(words) + r')\b',
		lambda match: values[match.group().lower()], text, flags=re.I)
	text = re.sub(r'\bsquared\b', '^2', text, flags=re.I)
	text = re.sub(r'\bcubed\b', '^3', text, flags=re.I)
	text = text.replace('²', '^2').replace('³', '^3')
	return re.findall(r'\d+(?:[.,]\d+)?', text)


def read_letter(png):
	if held():
		raise RuntimeError("Gemini is resting after a 429; try again in a minute")
	first = " ".join(str(gemini(READ_SYS, "The note:", png).get("text", "")).split())
	# A single misread digit silently changes the question the agent answers.
	# Check numeric notes against a second, unprimed image reading. Disagreement
	# becomes an inline clarification, never a guessed arithmetic answer.
	if numeric_read_signature(first):
		second = " ".join(str(gemini(NUMBER_READ_SYS, "The note:", png).get("text", "")).split())
		if (numeric_read_signature(first) != numeric_read_signature(second)
			or "[unclear" in second.lower()):
			return f"[unclear handwriting: one reading was {first!r}; another was {second!r}]"
	return first


def send(pane, text):
	"""text into an agent's pane, and Enter. Only a pane herdr lists as an agent's now."""
	a = next((a for a in agent_list() if a.get("pane_id") == pane), None)
	text = " ".join(text.split())
	if not a or not text:
		raise ValueError("no such desk, or nothing to send")
	subprocess.run(["herdr", "pane", "run", pane, text], check=True, capture_output=True, timeout=10)
	return a.get("name") or a.get("agent", "?")


def post_letter(pane, text):
	name, at = send(pane, text), int(time.time())
	if pane in pages:
		threading.Thread(target=answer, args=(pane, pages.pop(pane), at), daemon=True).start()
	letters.append({"name": name, "at": int(time.time()), "text": " ".join(text.split())})
	del letters[:-200]
	with open(f"{CACHE}/letters.json", "w") as f:
		json.dump(letters, f)
	return name


