XOCHITL = "/home/root/.local/share/remarkable/xochitl"
PAGE_FIND = r"""cd /home/root/.local/share/remarkable/xochitl || exit 1
for m in *.metadata; do
	grep -q '"deleted": true' "$m" && continue
	grep -q '"parent": "trash"' "$m" && continue
	grep -qiF "\"visibleName\": \"to $NAME\"" "$m" || continue
	f=$(ls -t "${m%.metadata}"/*.rm 2>/dev/null | head -n 1)
	[ -n "$f" ] || { echo none; exit 0; }
	echo "$f"; cat "$f"; exit 0
done
echo missing"""


def tablet(script, data=b""):
	r = subprocess.run([*tablet_ssh(TABLET), script], input=data,
		capture_output=True, timeout=30, env={**os.environ, "SSH_AUTH_SOCK": R1_SOCK})
	if (r.returncode == 255 and TABLET == "root@remarkable.lan"
		and b"Could not resolve hostname remarkable.lan" in r.stderr):
		# Same tablet, mDNS spelling; require its existing known host identity.
		# No network configuration change and no trust-on-first-use fallback.
		r = subprocess.run([*tablet_ssh("root@remarkable.local"), script], input=data, capture_output=True, timeout=30,
			env={**os.environ, "SSH_AUTH_SOCK": R1_SOCK})
	if r.returncode == 255:
		raise RuntimeError("the tablet isn't answering")
	return r.stdout


def notebook_page(name):
	"""The latest page of the tablet's notebook "To NAME": (its path under XOCHITL, its .rm bytes); ValueError when
	there is none."""
	if not re.fullmatch(r"[\w .-]{1,40}", name):
		raise ValueError("no notebook for that name")
	head, _, data = tablet("sh", f"NAME={shlex.quote(name)}\n{PAGE_FIND}".encode()).partition(b"\n")
	if head in (b"", b"missing"):
		raise ValueError(f"no notebook \u201cTo {name}\u201d on the tablet")
	if head == b"none" or not data:
		raise ValueError(f"nothing written in \u201cTo {name}\u201d yet (close the notebook so it saves)")
	return head.decode(), data


def read_page(pane):
	"""What the owner wrote on the latest page of the notebook for the desk in pane."""
	a = next((a for a in agent_list() if a.get("pane_id") == pane), None)
	if not a:
		raise ValueError("no such desk")
	path, data = notebook_page(a.get("name") or a.get("agent", "?"))
	png = render_page(data)
	if not png:
		raise ValueError("nothing new written since the last answer on its latest page")
	text = read_letter(base64.b64encode(png).decode())
	pages[pane] = path
	return text


def respond(doc, page="", live=False, supersedes="", stream_supported=False):
	"""respond_once, with its outcome traced under the request id it would have had."""
	marker = "notebook-" + uuid.uuid4().hex
	trace.event('press', request=marker, doc=doc, page=page or None, live=live, supersedes=supersedes or None)
	try:
		result = respond_once(marker, doc, page, live, supersedes, stream_supported)
	except Exception as e:
		trace.event('refused', 'failed', request=marker, reason=f'{type(e).__name__}: {e}')
		raise
	return result


def respond_once(marker, doc, page="", live=False, supersedes="", stream_supported=False):
	"""The notebook's Respond button: what the owner wrote on page (else the notebook's latest) of notebook doc, a
	"To NAME", read and sent to that desk; its answer then comes onto the page. -> {"to", "text", "page"}"""
	if not isinstance(supersedes, str) or supersedes and not re.fullmatch(r'notebook-[0-9a-f]{32}', supersedes):
		raise ValueError('Exact previous notebook request required')
	# Include metadata/agent lookup and capture, not only the OCR/model work.
	# Keep this attempt local until it has a new request identity: status polls
	# for the previous exchange must never acquire the next exchange's timings.
	stages = {"respond": time.monotonic()}
	if not re.fullmatch(r"[0-9a-f-]{36}", doc):
		raise ValueError(f"not a notebook: {doc[:40]!r}")
	if not re.fullmatch(r"[0-9a-f-]{36}", page):
		page = ""
	m = re.search(rb'"visibleName": "[Tt]o ([^"]+)"', tablet(f"cat {XOCHITL}/{doc}.metadata"))
	name = m.group(1).decode() if m else ""
	stages["metadata_ready"] = time.monotonic()
	a = next((a for a in agent_list() if (a.get("name") or a.get("agent", "")).lower() == name.lower()), None)
	if not a:
		raise ValueError(f"no desk called {name}" if name else "this notebook isn't a \u201cTo NAME\u201d")
	stages["dispatch_resolved"] = time.monotonic()
	if not page:
		page = os.path.basename(tablet(f"ls -t {XOCHITL}/{doc}/*.rm | head -n 1").decode().strip())[:-3]
	path = f"{doc}/{page}.rm"
	trace.event('page_read', request=marker, path=path, desk=name)
	global notebook_replay
	fixture = None
	with pending_lock:
		candidate = notebook_replay
		if candidate and candidate.get('path') == path and candidate.get('fixture'):
			# An expired/changed fixture must never turn into a real model call.
			notebook_replay = None
			if not live or candidate['expires'] <= time.time():
				raise ValueError('Renderer fixture expired or requires the live native path')
			fixture = candidate
			check_renderer_fixture(fixture)
		replay = notebook_replay and notebook_replay.get("path") == path and notebook_replay["expires"] > time.time()
		if replay:
			notebook_replay = None
		if fixture:
			replay = True
	route = notebook_model_route(doc, name, live) if not fixture else None
	# A full agent session can act on handwritten requests (including sends).
	# Until an exact recipient/payload has on-page confirmation, never fall
	# back to that session. Isolated model calls have no tools; fixtures are local.
	if not fixture and not route:
		raise ValueError('Notebook requires an isolated model route; agent-session forwarding is disabled until on-page send confirmation is available')
	if route and route.get('response_format') == 'story-stream-v1' and stream_supported is not True:
		raise ValueError('Notebook answer streaming requires a streaming-capable native client')
	if supersedes and (not route or replay):
		raise ValueError('New-question replacement requires the live model route')
	model_context = None
	previous_model_job = None
	replacing = False  # the page's pending request is replaced by this one once its capture succeeds
	if route:
		model_context = device_context.snapshot()
		if (model_context.get('doc') != doc or model_context.get('page') != page or
			not model_page_current(model_context)):
			raise ValueError('Notebook model requires the unchanged active page')
		with pending_lock:
			previous_model_job = pend('').get(path)
			if previous_model_job and not model_request_replaceable(previous_model_job, supersedes):
				check_replaceable(path, previous_model_job)
				replacing, supersedes = True, ''
			if not replacing and (previous_model_job or supersedes) and not model_request_replaceable(previous_model_job, supersedes):
				raise ValueError('A notebook request is already pending on this page')
	image_context = LATEST_IMAGE_CONTEXT
	if live:
		frame = live_capture(tablet)
		baseline_path = live_baseline(path)
		baseline = None
		if os.path.isfile(baseline_path) and not replay:
			from PIL import Image
			with Image.open(baseline_path) as saved:
				baseline = saved.convert("L")
		note_frames[path] = (frame, baseline)  # a note texted from this page is cut from this capture
		for old in list(note_frames)[:-8]:
			del note_frames[old]
		if route:
			crop, image_context = notebook_visual_input(frame, baseline)
		else:
			crop = notebook_crop(frame, baseline)
		png = live_png(crop) if crop is not None else None
	else:
		png = render_page(tablet(f"cat {XOCHITL}/{path}"), new_only=not replay)
	if not png:
		trace.event('new_ink', 'none', request=marker, path=path, replay=bool(replay),
			baseline=time.strftime('%Y-%m-%dT%H:%M:%S', time.localtime(os.path.getmtime(live_baseline(path)))) if live and os.path.isfile(live_baseline(path)) else 'none',
			frame=trace_image(marker, 'frame', frame) if live else None, compared_with=live_baseline(path) if live else None)
		raise ValueError("nothing new written since the last answer")
	trace.event('new_ink', request=marker, path=path, png_bytes=len(png), route=bool(route), replay=bool(replay))
	stages["reader_image_ready"] = time.monotonic()
	# The staged lesson rollout uses the answering agent's vision directly.
	# Do not make the page wait for a second provider or replace its math with
	# a cheap transcription. Non-lesson/legacy requests retain their reader.
	image_primary = bool(fixture) or live and lesson_enabled(doc)
	if image_primary:
		text = ""  # explicitly no transcription, not an assertion of no writing
	else:
		text = read_letter(base64.b64encode(png).decode())
		stages["transcribed"] = time.monotonic()
	os.makedirs(f"{CACHE}/pages", exist_ok=True)
	seen = f"{CACHE}/pages/{doc[:8]}-{time.strftime('%Y%m%d-%H%M%S')}.png"   # the page as written, for the desk to look at
	with open(seen, "wb") as stream:
		stream.write(png)
	sent = int(time.time())
	job = [a["pane_id"], path, sent, True, marker, None, live]
	with pending_lock:
		if route and path in media_tests and media_tests[path]['expires'] > time.time():
			raise ValueError('Prepared attachment tests require the existing media route')
		media_test = media_tests.pop(path, None) if not fixture else None
		if media_test and media_test["expires"] > time.time():
			job.append([media_test["asset"]])
	with pending_lock, native_ink_runs.lock:
		reply_timings[path] = stages
		trace.bind(path, marker)
		if fixture:
			check_renderer_fixture(fixture)
			job = start_notebook_job(with_delivery(job, renderer_fixture=True, response_format='semantic-v1'))
			notebook_names[marker] = 'Renderer Test'
			notebook_reply(marker, fixture['response'])
			stages['fixture_ready'] = time.monotonic()
			return {'to':'Renderer Test', 'text':'Renderer fixture; no agent call.',
				'page':path, 'live':True, 'request':marker, 'renderer_fixture':fixture['fixture']}
		if route:
			if (not model_page_current(model_context) or pend('').get(path) != previous_model_job or
				not replacing and (previous_model_job or supersedes) and not model_request_replaceable(previous_model_job, supersedes)):
				raise ValueError('Notebook page or pending request changed during capture')
			if replacing:
				check_replaceable(path, previous_model_job)
				clear_pending(path, previous_model_job,
					f'Replaced by a newer Respond on this page ({marker}); it was {answers.get(path)}')
			if len(job)>7 and job[7]:
				raise ValueError('Prepared attachment tests require the existing media route')
			job = start_notebook_job(with_delivery(job, response_format='semantic-v1', model_transport='pi-socket-v1'))
			notebook_names[marker] = name
			stages['submitted'] = time.monotonic()
			trace.event('submitted', request=marker, path=path, socket=os.path.basename(route.get('socket') or ''),
				format=route.get('response_format'), supersedes=supersedes or None)
			try:
				prestart = take_prestart(path) if live and route.get('response_format') not in (
					'story-panel-v1', 'story-stream-v1', 'role-production-v1') else None
				threading.Thread(target=notebook_model_answer, args=(job, route, png, model_context, image_context, prestart),
					daemon=True).start()
			except Exception:
				answers[path] = 'failed'
				reply_errors[path] = 'Notebook model worker unavailable; no automatic resend'
				raise ValueError('Notebook model worker unavailable') from None
			return {'to':name, 'text':'', 'page':path, 'live':True, 'request':marker}


def lesson_draft_tool(request):
	"""Advertise this deployment's offline compiler, not a different worktree.

	No scratch folder or new job/lease is created here. The answering agent
	controls its own draft files; only its final transcript reply is collected.
	"""
	if not isinstance(request, str) or not re.fullmatch(r'notebook-[0-9a-f]{32}', request):
		raise ValueError('exact notebook request required for author preview')
	if not lesson_rollout_config()['draft_check']:
		return None
	tool = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'notebook_lesson_eval.py')
	if not os.path.isfile(tool):
		return None  # older deployments must not advertise an unavailable command
	return {'command': shlex.join([sys.executable, tool, 'check']),
		'directory': os.path.expanduser('~/.buzz/OUTBOX/notebook-drafts/'+request)}


# The answer, in a hand, under the letter on its page: once the desk has finished its turn after the letter went.
# The tablet saves an open notebook over the file, so a reply it wrote over is written again (for a while).
ANSWER_WAIT, KEEP = 2700, 1200   # seconds: how long a desk may take to answer; how long the answer is kept on the page
pages = {}     # pane -> the page its last letter was read from, until the letter is sent
answers = trace.Traced('state')   # page -> waiting | ready | written | failed | no answer: for the notebook's Respond button (/answer)
ready = {}     # page -> the answer the button will have written (/write)
notebook_jobs = {}  # request ID -> the pending job, including an optional durable reply
notebook_names = {}  # bounded request -> validated dispatch display name; no send authority
notebook_answer_streams = {}  # request -> bounded in-flight prose, never a durable replay queue
reply_errors = trace.Traced('held', failed=True)
reply_timings = {}
ink_fallbacks = set()  # requests whose drawing was left out because the page's anchors can't be proven safe
retry_requests = {}  # explicit pre-insertion repair authorization, never an automatic resend
reply_reader = ReplyReader()
notebook_replay = None  # one explicitly armed replay for controlled testing, expires in 30 seconds
media_tests = {}  # page -> one bounded attachment test on its next request
media_store = AssetStore(f"{CACHE}/assets")
notebook_auth = None  # Fail closed until startup loads the private capability file.


def check_renderer_fixture(fixture):
	"""Reuse current telemetry, not another lease or audit store."""
	context = device_context.snapshot()
	if (not context.get('fresh') or not context.get('active') or
		any(context.get(k) != v for k,v in fixture['context'].items()) or
		not lesson_enabled(fixture['context']['doc'])):
		raise ValueError('Renderer fixture page, view or handwriting changed')


def arm_notebook_test(body):
	"""Existing local-only test arm; optional named fixtures never invoke a model."""
	global notebook_replay
	if not isinstance(body, dict) or set(body) not in ({'doc','page'}, {'doc','page','fixture'}):
		raise ValueError('Exact notebook test fields required')
	doc, page = body['doc'], body['page']
	for value in (doc, page):
		if not isinstance(value, str) or str(uuid.UUID(value)) != value:
			raise ValueError('Test replay requires canonical notebook and page UUIDs')
	armed = dict(path=doc+'/'+page+'.rm', expires=time.time()+30)
	if 'fixture' in body:
		from notebook_semantic_examples import examples
		fixtures = examples()
		name = body['fixture']
		if not isinstance(name, str) or name not in fixtures:
			raise ValueError('Unknown renderer fixture')
		response = json.dumps(fixtures[name])
		parse_semantic_reply(response)  # whole lesson before arming/device work
		context = device_context.snapshot()
		if context.get('doc') != doc or context.get('page') != page:
			raise ValueError('Renderer fixture requires the active test page')
		armed.update(fixture=name, response=response, context={k:context.get(k) for k in
			('doc','page','surface','view','content_revision','ink_revision')})
		check_renderer_fixture(armed)
		metadata = json.loads(tablet(f'cat {XOCHITL}/{doc}.metadata'))
		parent = metadata.get('parent')
		if not isinstance(parent,str) or str(uuid.UUID(parent)) != parent:
			raise ValueError('Renderer fixture folder unavailable')
		folder = json.loads(tablet(f'cat {XOCHITL}/{parent}.metadata'))
		if metadata.get('visibleName') != 'To pidog' or folder.get('visibleName') != 'Storyboard tests (Codex)':
			raise ValueError('Renderer fixtures require the isolated test notebook')
	with pending_lock:
		if 'fixture' in armed:
			check_renderer_fixture(armed)
			if armed['path'] in pend('') or notebook_replay and notebook_replay['expires'] > time.time():
				raise ValueError('A notebook request or test is already pending')
		armed['expires'] = time.time()+30
		notebook_replay = armed
	return dict(armed=True, expires_in=30, **({'renderer_fixture':body['fixture']} if 'fixture' in body else {}))


def answer(pane, path, sent, hold=False, marker=None, recovered=None, live=False, media=None, delivery=None):
	"""hold (the notebook's button): don't write it; keep it "ready" for /write, which the button calls once it has
	closed the notebook, so the tablet can't save over it."""
	semantic = semantic_delivery([pane,path,sent,hold,marker,recovered,live,media,delivery])
	current_job = notebook_jobs.get(marker)
	if current_job:
		semantic = semantic or semantic_delivery(current_job)
	if semantic and (not hold or not live or not marker):
		raise ValueError('semantic replies require a held live request')
	if recovered is not None:
		with pending_lock:
			notebook_reply(marker, recovered)
			# Recovery must not advertise a possibly partial native insertion as
			# ready. Retain the old answer and attempt; never replay or confirm it.
			if (current_job and delivery_options(current_job).get('model_transport') == 'pi-socket-v1' and
				matching_native_attempt(current_job)):
				native_text_failed(path, marker)
		return
	if path in ready:
		return
	if (delivery_options([pane,path,sent,hold,marker,recovered,live,media,delivery]).get('model_transport') or
		current_job and delivery_options(current_job).get('model_transport')):
		# A restart cannot resume an in-process model stream. Preserve this job
		# without redispatching it or reading an unrelated shared chat transcript.
		with pending_lock:
			current = pend('').get(path)
			if current and current[4] == marker:
				trace.bind(path, marker)
				answers[path] = 'failed'
				reply_errors[path] = 'Notebook model connection interrupted; no automatic resend'
		return
	answers[path] = "waiting"
	end = time.time() + ANSWER_WAIT
	while time.time() < end:
		time.sleep(.25 if marker else 1)
		if marker:
			current = pend("").get(path)
			if not current or (len(current) > 4 and current[4] != marker):
				return
		if path in ready:
			return
		try:
			if marker:
				matched_reply = reply_reader.answer(marker, sent)
				if matched_reply:
					# The structured reader has already checked final-message status
					# and exact request identity. Unrelated terminal busy status must
					# not delay delivery or require a legacy Claude-only thread scan.
					if hold:
						notebook_reply(marker, matched_reply)
					else:
						write_answer(path, matched_reply)
					return
				continue
			th = thread(pane)
		except Exception as e:
			reply_errors[path] = "Reply reader unavailable: " + type(e).__name__
			continue
		said = [i for i in th["items"] if i["who"] == "agent" and i["at"] >= sent - 2]
		if said and th["status"] != "working":
			said[-1] = dict(said[-1], text=said[-1]["text"] + ("\n```svg\n" + said[-1]["svg"] + "\n```" if said[-1].get("svg") else ""))
			if hold:
				ready[path] = said[-1]["text"]; answers[path] = "ready"
				return
			try:
				write_answer(path, said[-1]["text"])
			except Exception as e:
				answers[path] = "failed"
				print(time.strftime("%T"), "answer", path, type(e).__name__, str(e)[:120], file=sys.stderr)
			return
	answers[path] = "no answer"
	reply_errors[path] = "No completed reply reached this notebook; the agent's return connection needs checking"


PENDING = os.path.expanduser("~/.cache/herd-board-pending.json")   # answers awaited, so a restart keeps waiting
pending_lock = threading.RLock()


def pend(path, job=None):
	with pending_lock:
		return pending_update(path, job)


def pending_update(path, job=None):
	try:
		with open(PENDING) as stream:
			p = json.load(stream)
	except Exception:
		p = {}
	if path == "" and job is None:
		return p
	if job:
		p[path] = job
	else:
		p.pop(path, None)
	os.makedirs(os.path.dirname(PENDING), exist_ok=True)
	with open(PENDING + ".new", "w") as stream:
		json.dump(p, stream)
	os.replace(PENDING + ".new", PENDING)
	return p


def resume():
	for job in pend("").values():
		if time.time() - job[2] < ANSWER_WAIT:
			if len(job) == 4:
				# Older sends already carry a unique image basename in the prompt.
				# Recover that correlation rather than asking James to resend.
				candidates = []
				for image in glob.glob(f"{CACHE}/pages/{job[1][:8]}-*.png"):
					modified = os.path.getmtime(image)
					if job[2] - 60 <= modified <= job[2] + 2:
						candidates.append((modified, image))
				if len(candidates) == 1:
					job = job + [os.path.basename(candidates[0][1])]
					pend(job[1], job)
			if len(job) > 4:
				notebook_jobs[job[4]] = job
			threading.Thread(target=answer, args=tuple(job), daemon=True).start()


def notebook_reply(request, text):
	"""Hold an answer for a specific pending notebook job; never write an open page."""
	with pending_lock:
		job = notebook_jobs.get(request)
		if not job or time.time() - job[2] >= ANSWER_WAIT:
			raise ValueError("unknown or expired notebook request")
		if not isinstance(text, str) or not text.strip():
			raise ValueError("reply must be 1 to 16000 characters of text")
		semantic = semantic_delivery(job)
		if semantic:
			from notebook_semantic import MAX_BYTES
			if len(text.encode('utf-8')) > MAX_BYTES:
				raise ValueError('semantic response exceeds its byte budget')
		elif has_lesson(text):
			from notebook_lesson import MAX_RESPONSE
			if len(text.encode('utf-8')) > MAX_RESPONSE:
				raise ValueError('lesson response exceeds its byte budget')
		elif len(text) > 16000:
			raise ValueError("reply must be 1 to 16000 characters of text")
		path = job[1]
		current = pend("").get(path)
		if current and len(current) > 4 and current[4] != request:
			raise ValueError("notebook request has been superseded by a newer send")
		if answers.get(path) == "written":
			return {"state": "written"}
		if semantic and current != job:
			raise ValueError('semantic request binding changed or is missing')
		if delivery_options(job).get('model_transport'):
			parse_semantic_reply(text)  # callbacks/recovery cannot bypass full validation
		if revision_pending(job):
			if text.strip() != job[5]:
				raise ValueError('pending revision cannot be replaced by a reply callback')
			# resume() must not publish a corrected answer before explicit retry.
			ready.pop(path, None)
			answers[path] = 'revision-held'
			reply_errors[path] = 'Corrected lesson held; explicit retry still required'
			return {'state': 'revision-held'}
		if not semantic and text.strip() == "[[notebook-media-pending]]":
			if path in ready:
				return {"state": "ready"}  # A completed media callback won the race.
			job = job[:5] + [text.strip()] + job[6:]
			pend(path, job)
			notebook_jobs[request] = job
			answers[path] = "waiting"
			reply_errors.pop(path, None)
			return {"state": "waiting", "media_pending": True}
		if path in ready:
			if ready[path] != text.strip():
				raise ValueError("a different answer is already held for this request")
			return {"state": "ready"}
		job = job[:5] + [text.strip()] + job[6:]
		pend(path, job)
		notebook_jobs[request] = job
		ready[path] = text.strip()
		answers[path] = "ready"
		reply_timings.setdefault(path, {})["reply_ready"] = time.monotonic()
		reply_errors.pop(path, None)
		return {"state": "ready"}


def revise_notebook_response(request, expected_sha256, text):
	"""Replace one invalid, stopped lesson; never import, insert or arm retry.

	Local-only repair of a pre-insertion validation failure, not
	general editing of accepted replies. The old text digest is compare-and-swap
	and all existing insertion state is retained. Validation is not quality review.
	"""
	from notebook_lesson import parse_lesson
	with pending_lock, native_ink_runs.lock:
		held = held_notebook_response(request)
		job = notebook_jobs[request]
		path = job[1]
		if (time.time() - job[2] >= ANSWER_WAIT or pend("").get(path) != job or
			len(job) < 7 or job[6] is not True or answers.get(path) != 'ready'):
			raise ValueError('revision requires a current unexpired live held reply')
		if not native_retry_safe(job) or path in lesson_imports or retry_requests.get(request):
			raise ValueError('revision requires no pending import, retry or insertion')
		native_ink_runs.require_unprepared(request)
		old = held['text']
		if (not isinstance(expected_sha256, str) or not re.fullmatch(r'[0-9a-f]{64}', expected_sha256) or
			hashlib.sha256(old.encode('utf-8')).hexdigest() != expected_sha256):
			raise ValueError('held reply changed; inspect the exact original before revising')
		semantic = semantic_delivery(job)
		if (not semantic and not has_lesson(old)) or not lesson_enabled(path.split('/')[0]):
			raise ValueError('revision is limited to invalid enabled board lessons')
		validate = parse_semantic_reply if semantic else parse_lesson
		try:
			validate(old)
		except ValueError:
			pass
		else:
			raise ValueError('valid held lesson cannot be replaced by this repair route')
		validate(text)  # whole lesson/equation/budgets; no assets or device I/O
		text = text.strip()
		# Re-read durable attempt/journal state immediately before committing.
		if not native_retry_safe(job):
			raise ValueError('insertion may already have started; revision refused')
		native_ink_runs.require_unprepared(request)
		revised = with_delivery(job[:5] + [text] + job[6:], revision_pending=True)
		pend(path, revised)  # persist first: an I/O failure leaves in-memory state intact
		notebook_jobs[request] = revised
		# The same pending job holds the correction, but no writer can see it
		# through ready until retry. No extra journal/lease or second job store.
		ready.pop(path, None)
		answers[path] = 'revision-held'
		reply_errors[path] = 'Corrected lesson held; explicit retry still required'
		reply_timings.setdefault(path, {})['reply_revised'] = time.monotonic()
		return dict(state='revision-held', request=request, page=path, revised=True, retry_armed=False,
			sha256=hashlib.sha256(text.encode('utf-8')).hexdigest())


def start_notebook_job(job, *, response_format=None):
	"""Pin a service-selected protocol before dispatch; no live selector yet.

	The future isolated transport may opt in with response_format. Neither the
	model response nor a tablet request can select or change this format.
	"""
	with pending_lock:
		if response_format is not None:
			if len(job)>5 and job[5] is not None:
				raise ValueError('response format must be selected before dispatch')
			job = with_delivery(job,response_format=response_format)
		delivery_options(job)
		path, marker = job[1], job[4]
		previous = notebook_jobs.get(marker)
		if previous and semantic_delivery(previous) != semantic_delivery(job):
			raise ValueError('response format cannot rebind an existing request')
		if semantic_delivery(job):
			if (len(job)<7 or job[3] is not True or job[6] is not True or
				not isinstance(marker,str) or not re.fullmatch(r'notebook-[0-9a-f]{32}',marker) or
				not lesson_enabled(path.split('/')[0])):
				raise ValueError('semantic replies require an enabled held live request')
			if job[5] is not None or revision_pending(job):
				raise ValueError('semantic format must be pinned on a new unanswered request')
			if marker in notebook_jobs:
				raise ValueError('response format cannot rebind an existing request')
		pend(path, job)
		ready.pop(path, None)
		reply_errors.pop(path, None)
		notebook_jobs[marker] = job
		answers[path] = "waiting"
		return job


def write_ready(path):
	"""The notebook's button, its notebook closed: the answer held for path, onto the page, once."""
	if path not in ready:
		raise ValueError("no answer waiting for that page")
	job = pend('').get(path)
	current = notebook_jobs.get(answer_status(path)['request'])
	if (job and semantic_delivery(job)) or (current and semantic_delivery(current)):
		raise ValueError('semantic replies require the native writer; no legacy file write')
	reply_timings.setdefault(path, {})["write_started"] = time.monotonic()
	where = write_answer(path, ready[path], keep=0) or path
	reply_timings[path]["written"] = time.monotonic()
	print(time.strftime("%T"), "notebook timing", json.dumps(timing_status(path)), file=sys.stderr, flush=True)
	del ready[path]
	pend(path)
	return {"state": answers[where], "page": where, "idx": page_index(where)}


def live_baseline(path):
	if not re.fullmatch(r"[0-9a-f-]{36}/[0-9a-f-]{36}\.rm", path):
		raise ValueError("not a notebook page")
	return f"{CACHE}/pages/live-{path.replace('/', '-').removesuffix('.rm')}.png"


def native_image_resources(path):
	live_baseline(path)  # validates the exact notebook/page target
	directory = f"{XOCHITL}/{path.removesuffix('.rm')}"
	listing = tablet(f"find {directory} -maxdepth 1 -type f 2>/dev/null || true").decode()
	return [name for name in listing.splitlines()
		if re.fullmatch(re.escape(directory) + r"/[0-9a-f-]{36}\.(?:jpg|png)", name)]


def native_media_proof(path, request, assets=None):
	"""Verify newly persisted image pixels AND their reference in the saved page."""
	with pending_lock:
		job = pend("").get(path)
		if not job or len(job) < 8 or job[4] != request:
			raise ValueError("no matching notebook image request")
		wanted = job[7] if assets is None else assets
		if not isinstance(wanted, list) or not wanted or len(wanted) > 6 or any(
			not isinstance(asset, str) or asset not in job[7] for asset in wanted):
			raise ValueError("image proof requires media from this exact request")
		with open(live_baseline(path) + ".media-before.json") as stream:
			before = json.load(stream)
		if before["request"] != request:
			raise ValueError("notebook image request has been superseded")
		files = [name for name in native_image_resources(path) if name not in before["files"]]
		if len(files) < len(wanted):
			return {"state": "waiting", "reason": "image resource not saved yet"}
		if len(files) > 12:
			raise ValueError("too many image changes during this notebook request")
		from PIL import Image, ImageChops, ImageStat
		data = tablet(f"cat {XOCHITL}/{path}")
		matched = []
		for asset in wanted:
			with Image.open(io.BytesIO(media_store.get(asset))) as source:
				expected = source.convert("L")
			found = None
			for name in files:
				if name in matched:
					continue
				# This firmware's minimal BusyBox head has no -c option.
				# dd is available (also used by the bounded framebuffer reader).
				pixels = tablet(f"dd if={name} bs=4096 count=2930 2>/dev/null")
				if len(pixels) > 12_000_000:
					continue
				with Image.open(io.BytesIO(pixels)) as image:
					if image.size != expected.size:
						continue
					image = image.convert("L")
				if ImageStat.Stat(ImageChops.difference(expected, image)).mean[0] > 8:
					continue
				identity = os.path.basename(name).rsplit(".", 1)[0]
				if not any(value in data for value in (identity.encode(), uuid.UUID(identity).bytes, uuid.UUID(identity).bytes_le)):
					return {"state": "waiting", "reason": "image is visible but page save is pending"}
				found = name
				break
			if not found:
				return {"state": "waiting", "reason": "matching image resource not found"}
			matched.append(found)
		return {"state": "persisted", "images": len(matched)}


def native_ack_context(path, settling=False):
	"""Identity/input guard; viewport settling is checked using paper pixels."""
	context = device_context.snapshot()
	if not context.get('available'):
		return None  # legacy client without native geometry telemetry
	doc, page = path.removesuffix('.rm').split('/')
	if (context.get('doc') != doc or context.get('page') != page or
		(not settling and (not context.get('fresh') or not context.get('active')))):
		raise ValueError('Return to the original active page before confirming the reply')
	return (context['surface'], tuple(context['view']), context['ink_revision'])


def native_text(path, request="", done=False, ink_supported=False, imported=None, import_supported=True,
                preservation_supported=False, layout=None, reveal_supported=False, playback_supported=False,
                pen_equations_supported=False, story_supported=False, hand_supported=False):
	"""Prepare a held string for xochitl's native editor; acknowledge only visible insertion."""
	with pending_lock:
		job = pend("").get(path)
		if not job or len(job) < 7 or job[6] is not True or path not in ready:
			raise ValueError("no live answer waiting for that page")
		current = notebook_jobs.get(job[4])
		semantic = semantic_delivery(job) or bool(current and semantic_delivery(current))
		parsed = None
		if semantic:
			if current != job or time.time()-job[2]>=ANSWER_WAIT or ready[path] != job[5]:
				raise ValueError('semantic request binding changed or expired')
			if not lesson_enabled(path.split('/')[0]):
				raise ValueError('native semantic replies are not enabled for this notebook')
			parsed = parse_semantic_reply(ready[path])
		lesson = parsed['mode']=='lesson' if semantic else has_lesson(ready[path])
		baseline = live_baseline(path)
		attempt = baseline + ".native-attempt"
		if done:
			if request != job[4] or not os.path.isfile(attempt):
				raise ValueError("native acknowledgement does not match the request")
			with open(attempt) as stream:
				if stream.read() != request:
					raise ValueError("native acknowledgement has been superseded")
			if len(job) > 7 and job[7] and native_media_proof(path, request)["state"] != "persisted":
				raise ValueError("notebook image is not saved yet; answer remains held")
			if (request not in ink_fallbacks and (lesson or (not semantic and '[[notebook-ink:' in ready[path])) and
				native_ink_proof(request)["state"] != "persisted"):
				raise ValueError("native drawing save is not confirmed; answer remains held")
			from PIL import Image
			with Image.open(baseline + ".before.png") as saved:
				proof = json.loads(saved.info.get('native_context', '{}'))
				before_context = proof.get('context')
				if proof.get('request') != request or before_context is None:
					raise ValueError('No pre-insertion viewport proof; answer remains held')
				before = saved.convert("L")
			# Native isLoading can briefly be true while the automatic scroll
			# finishes. Freeze identity/input now, require fresh active geometry
			# AFTER the stable-paper samples, not before their settling window.
			context = native_ack_context(path, settling=True)
			after = live_capture(tablet)
			after = settled_frame(after, lambda: live_capture(tablet))
			final_context = native_ack_context(path)
			# Automatic native scrolling may finish during capture: the stable
			# pixels above, not the initial affine view, define the final image.
			# A different surface/new pen input must NEVER be swallowed as baseline.
			identity = lambda value: (value[0], value[2]) if value is not None else None
			if identity(final_context) != identity(context) or identity(context) != identity(before_context):
				raise ValueError('Page or handwriting changed while confirming the reply; input baseline not saved')
			if aligned_writing_box(after, before, before_context[1], final_context[1]) is None:
				# A long reply scrolls the view past the paper seen before it; then its ink is on newly exposed paper.
				exposed, rows = exposed_writing_box(after, before_context[1], final_context[1])
				evidence = dict(request=request, path=path, before=baseline + ".before.png",
					after=trace_image(request, 'after', after), view_before=before_context[1],
					view_after=final_context[1], observed_rows=rows)
				if exposed is None:
					trace.event('acknowledged', 'not visible', **evidence)
					raise ValueError('native text was not visible on previously observed paper; answer remains held')
				trace.event('acknowledged', 'scrolled', exposed_box=list(exposed), **evidence)
			after.save(baseline)
			reply_timings.setdefault(path, {})["written"] = time.monotonic()
			answers[path] = "written"
			reply_errors.pop(path, None)
			del ready[path]
			pend(path)
			print(time.strftime("%T"), "native text visible", path, "timing", json.dumps(timing_status(path)), file=sys.stderr, flush=True)
			trace.event('acknowledged', request=request, path=path, timing=timing_status(path))
			return {"state": "written", "page": path}
		if os.path.isfile(attempt):
			with open(attempt) as stream:
				if stream.read() == job[4]:
					raise ValueError("Native text already attempted; inspect the page before retrying")
		anchor_error = None  # set when the page's text anchors can't be proven safe for a drawing
		if layout is not None:
			if (not preservation_supported or not isinstance(layout, dict) or
				layout.get('command', {}).get('request') != job[4] or layout.get('command', {}).get('phase') != 'before'):
				raise ValueError('native before-layout measurement belongs to another reply')
			mark_reply_timing(path, 'native_before_layout_received')
			try:
				native_ink_runs.finish_capture(layout, device_context.snapshot, native_saved_page)
			except ValueError as e:
				if 'native text anchor' not in str(e):
					raise
				anchor_error = e
			mark_reply_timing(path, 'native_before_layout_measured')
		# Monotonic request-relative stages separate polling, rendering, transfer,
		# framebuffer capture and identity lookup. Never log text or capabilities.
		stages = reply_timings.setdefault(path, {})
		mark_reply_timing(path, 'native_requested')
		from notebook_media import notebook_content, notebook_paragraph_styles, notebook_blocks
		catalog = None
		lesson_context = None
		if not semantic and '[[notebook-ink:' in ready[path]:
			if not ink_supported:
				raise ValueError("this tablet client does not support native drawing stages")
			catalog = load_catalog(INK_CATALOG)
		if lesson:
			if not ink_supported or not import_supported or not lesson_enabled(path.split('/')[0]):
				raise ValueError('native lessons are not enabled for this notebook/client')
			if parsed and 'story' in parsed and story_supported is not True:
				raise ValueError('native story client capability required')
			playback_supported = playback_supported is True and lesson_rollout_config().get('stroke_playback',False)
			pen_equations_supported = pen_equations_supported is True and playback_supported
			hand = lesson_rollout_config().get('reply_hand') if hand_supported is True and playback_supported else None
			reader = lesson_rollout_config().get('reader')
			opening = f"{reader}, {lesson_rollout_config().get('opening', 'once upon a time...')}" if reader else None
			if imported is None:
				previous = lesson_imports.get(path)
				if previous and previous['request'] == job[4]:
					raise ValueError('Lesson import already requested; reply remains held')
				if semantic:
					bundle = prepare_semantic_reply(ready[path], media_store,
						reveal=reveal_supported and not playback_supported, playback=playback_supported,
						pen_equations=pen_equations_supported, hand=hand, opening=opening,
						picture=picture_frames if lesson_rollout_config().get('picture') == 'image' else None)
					report = bundle.get('picture') or {}
					if report.get('used') or report.get('reason', 'no picture') != 'no picture':
						trace.event('picture', 'drawn' if report['used'] else 'procedural', request=job[4], path=path,
							stages=report.get('stages'), reason=report.get('reason'))
				else:
					bundle = prepare_native_lesson(ready[path], media_store)
				prepared = prepare_notebook_lesson_import(path, bundle)
				prepared.update(request=job[4], response=ready[path], bundle=bundle)
				lesson_imports[path] = prepared
				return {'request':job[4], 'import_source':prepared['command']}
			prepared = lesson_imports.get(path)
			if (not isinstance(imported, dict) or not prepared or
				imported.get('request') != job[4] or prepared['request'] != job[4] or
				prepared['response'] != ready[path]):
				raise ValueError('Lesson import callback is stale or superseded')
			if any('reveal' in b for b in prepared['bundle']['blocks']) and reveal_supported is not True:
				raise ValueError('Native reveal client capability changed during import')
			if any('playback' in b for b in prepared['bundle']['blocks']) and playback_supported is not True:
				raise ValueError('Native playback client capability changed during import')
			if any(b.get('role') == 'equation' for b in prepared['bundle']['blocks']) and pen_equations_supported is not True:
				raise ValueError('Native pen-equation client capability changed during import')
			if any(b.get('role') == 'hand' for b in prepared['bundle']['blocks']) and hand is None:
				raise ValueError('Native handwriting client capability changed during import')
			lesson_context = prepared['context']
			if native_ack_context(path) != lesson_context or device_context.snapshot().get('content_revision') != prepared['content_revision']:
				raise ValueError('Page or input changed during lesson import')
			bundle = remap_imported_lesson(prepared['bundle'], imported.get('doc'),
				prepared['command']['parent'], path.split('/')[0], tablet,
				validate_source=validate_native_ink_source)
			blocks = bundle['blocks']
			plain = '\n'.join(block['text'] for block in blocks if block['kind'] == 'text')
			equation_assets = [block['asset'] for block in blocks if block['kind'] == 'media']
		elif semantic:
			if imported is not None:
				raise ValueError('text-only semantic reply has no source import')
			plain = parsed['text']
			blocks = [dict(kind='text',text=plain,styles=[])]
			equation_assets = []
		else:
			blocks = notebook_blocks(ready[path], media_store, catalog)
			plain, equation_assets = notebook_content(ready[path], media_store, catalog)
		for block in blocks:
			if block['kind'] == 'ink' and not lesson:
				native_ink_source(block)  # verify EVERY source before the first text insertion
		stages["native_content_ready"] = time.monotonic()
		if equation_assets:
			attachments = list(job[7] or []) if len(job) > 7 else []
			for asset in equation_assets:
				if asset not in attachments:
					attachments.append(asset)
			job = job[:7] + [attachments] + job[8:]
			pend(path, job)
			notebook_jobs[job[4]] = job
		media = []
		if len(job) > 7 and job[7]:
			with open(baseline + ".media-before.json", "w") as stream:
				json.dump({"request": job[4], "files": native_image_resources(path)}, stream)
		for asset in ((job[7] or []) if len(job) > 7 else []):
			data = media_store.get(asset)
			remote = f"/home/root/.cache/herd-board/assets/{asset}.png"
			tablet(f"mkdir -p /home/root/.cache/herd-board/assets && cat > {remote}.new && mv {remote}.new {remote}", data)
			from PIL import Image
			with Image.open(io.BytesIO(data)) as image:
				media.append({"asset": asset, "url": "file://" + remote, "width": image.width, "height": image.height})
		# Old tablet patches ignore blocks and retain the legacy prose/media fields.
		# New patches consume this complete, validated sequence, with no local paths
		# or unregistered asset identifiers supplied by the agent.
		by_asset = {item["asset"]: item for item in media}
		for block in blocks:
			if block["kind"] == "media":
				block.update(by_asset[block["asset"]])
		# Attachments supplied out-of-band have no marker in the agent text. Keep
		# those at the end, rather than silently dropping pre-armed test media.
		placed = {block["asset"] for block in blocks if block["kind"] == "media"}
		blocks.extend(dict(kind="media", **item) for item in media if item["asset"] not in placed)
		stages["native_media_ready"] = time.monotonic()
		frame_context = native_ack_context(path)
		if lesson_context is not None and (frame_context != lesson_context or
			device_context.snapshot().get('content_revision') != prepared['content_revision']):
			raise ValueError('Page, viewport or handwriting changed after lesson preparation')
		frame = live_capture(tablet)
		if native_ack_context(path) != frame_context:
			raise ValueError('Page or viewport changed during the pre-insertion capture; answer remains held')
		box = writing_box(frame)
		stages["native_frame_ready"] = time.monotonic()
		# Reduce only the preferred placement margin, not the actual-ink guard
		# or native preliminary-gap algorithm. Existing page content is untouched.
		top = box[3] + NATIVE_REPLY_CLEARANCE if box else 165
		# Native text can extend the continuous notebook page beyond the viewport.
		name = 'Renderer Test' if delivery_options(job).get('renderer_fixture') else notebook_names.get(job[4])
		if not name:
			name = next((a.get("name") or a.get("agent", "") for a in agent_list()
				if a.get("pane_id") == job[0]), "Unknown")
		if re.sub(r"[^a-z]", "", name.lower()) == "pidog":
			name = "Pi Dog"
		stages["native_identity_ready"] = time.monotonic()
		from PIL.PngImagePlugin import PngInfo
		metadata = PngInfo()
		metadata.add_text('native_context', json.dumps({'request':job[4], 'context':frame_context}))
		frame.save(baseline + ".before.png", pnginfo=metadata)
		if any(block['kind'] == 'ink' for block in blocks):
			# Snapshot pre-existing line IDs before any insertion so an older
			# identical diagram cannot satisfy this request's saved-ink proof.
			before = tablet(f'if test -f {XOCHITL}/{path}; then dd if={XOCHITL}/{path} bs=1024 count=16384 2>/dev/null; fi')
			if not before:
				raise ValueError('native page is not saved yet; drawing remains held before insertion')
			if native_ack_context(path) != frame_context:
				raise ValueError('Page, viewport or handwriting changed before drawing registration')
			try:
				if anchor_error:
					raise anchor_error
				unknown = sorted({b['scene'] for b in blocks if b['kind'] == 'ink' and not ink_scene_known(b)})
				if unknown:
					raise ValueError('drawing not in the catalog: ' + ', '.join(unknown))
				registered = native_ink_runs.register(job[4], path, device_context.snapshot(), blocks, before,
					preservation=preservation_supported, blank_prose=reply_label(name, blocks) == '' and
					not any(b['text'] for b in blocks if b['kind'] == 'text'))
			except ValueError as e:
				if 'native text anchor' not in str(e) and 'not in the catalog' not in str(e):
					raise
				# The page's ink hangs off its typed text in a way the preservation proof can't follow, so a drawing
				# here could move it. Place the reply's words below the last ink, as for any typed answer, rather
				# than hold the whole reply; the drawing is left out, and the page says so.
				blocks = [b for b in blocks if b['kind'] != 'ink']
				plain = '\n'.join(b['text'] for b in blocks if b['kind'] == 'text' and b['text'])
				plain = (plain + '\n' if plain else '') + ('(The drawing could not be placed on this page; ask again on a fresh page.)'
					if 'anchor' in str(e) else '(The drawing was left out: it is not one this board can draw yet.)')
				blocks = [dict(kind='text', text=plain, styles=[])] + [b for b in blocks if b['kind'] == 'media']
				ink_fallbacks.add(job[4])
				trace.event('placed', 'fallback', request=job[4], path=path, reason=str(e), kept='text only')
				registered = {}
			if 'measure_layout' in registered:
				reason = registered.get('layout_reason', 'initial')
				if reason in ('initial', 'snapshot_changed', 'context_changed'):
					mark_reply_timing(path, 'native_before_layout_'+reason)
				return dict(request=job[4], **registered)
		with open(attempt, "w") as stream:
			stream.write(job[4])
		reply_timings.setdefault(path, {})["write_started"] = time.monotonic()
		answers[path] = "writing"
		lesson_imports.pop(path, None)
		return {"request": job[4], "text": plain, "top": top,
			"inkBottom": max(100, box[3] - 30) if box else 120,
			"label": reply_label(name, blocks), "media": media,
			"styles": [] if semantic else notebook_paragraph_styles(ready[path], plain), "blocks": blocks}


def reply_label(name, blocks):
	"""The reader's name opens a reply, as the Primer opened with Nell's; written by hand when the reply is."""
	try:
		reader = lesson_rollout_config().get('reader')
	except (OSError, ValueError):
		reader = None
	if not reader:
		return f"Agent {name}:"
	return '' if any(b.get('role') == 'hand' for b in blocks) else f"{reader},"


def native_text_failed(path, request):
	"""Record a stopped native attempt without authorizing replay or losing its proof."""
	with pending_lock:
		job = notebook_jobs.get(request)
		if not job or job[1] != path or len(job) < 7 or job[6] is not True:
			raise ValueError('native failure does not match a live request')
		# A delayed failure must not demote a confirmed save, or a newer request.
		current = answer_status(path)
		if current['request'] != request:
			raise ValueError('native failure has been superseded')
		if current['state'] == 'written':
			return {'state': 'written', 'request': request}
		attempt = live_baseline(path) + '.native-attempt'
		try:
			with open(attempt) as stream:
				matching = stream.read(128) == request
		except OSError:
			matching = False
		if not matching and current['state'] == 'ready' and native_retry_safe(job):
			# A preparation failure can occur before the durable insertion claim.
			# Keep the answer held, but consume any explicit repair hint so a
			# dismissal/reopen cannot replay that hint. Never clear an attempt,
			# import, source, or saved-content proof; only admin may re-arm.
			retry_requests.pop(request, None)
			reply_errors[path] = 'Tablet could not prepare this reply; answer held for inspection'
			reply_timings.setdefault(path, {}).setdefault('native_prepare_failed', time.monotonic())
			return {'state': 'ready', 'request': request, 'held': True}
		# resume() restores held answers as ready after a server restart. The
		# exact durable attempt still forbids replay and identifies this failure.
		if not matching or current['state'] not in ('writing', 'failed', 'ready'):
			raise ValueError('no matching native insertion attempt to stop')
		answers[path] = 'failed'
		reply_errors[path] = 'Tablet stopped while inserting this reply; inspect the page before retrying'
		reply_timings.setdefault(path, {}).setdefault('native_failed', time.monotonic())
		return {'state': 'failed', 'request': request}


def write_live(path):
	"""Place a held reply through the open notebook's native pen, with no disk edit."""
	with pending_lock:
		job = pend("").get(path)
		if not job or len(job) < 7 or job[6] is not True:
			raise ValueError("not a live notebook request")
		if path not in ready:
			raise ValueError("no answer waiting for that page")
		frame = live_capture(tablet)
		box = writing_box(frame)
		top = (box[3] if box else 120) + 45
		if top > 1400:
			raise ValueError("Not enough visible space below the writing for this reply")
		lines = compose(ready[path], top, bottom=1640)
		paths = [[(702 + x, y) for x, y, width in line] for line in lines]
		if not paths:
			raise ValueError("the answer has no drawable content")
		attempt = live_baseline(path) + ".attempt"
		if os.path.isfile(attempt):
			with open(attempt) as stream:
				if stream.read() == job[4]:
					raise ValueError("Native reply already attempted; check the page before retrying")
		with open(attempt, "w") as stream:
			stream.write(job[4])
		reply_timings.setdefault(path, {})["write_started"] = time.monotonic()
		answers[path] = "writing"
		ssh = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", TABLET]
		try:
			live_draw(paths, ssh, {**os.environ, "SSH_AUTH_SOCK": R1_SOCK})
			# Save the actual pixels after native rendering to exclude this answer
			# from the next handwritten request, without closing the document.
			time.sleep(.15)
			after = live_capture(tablet)
			if writing_box(after, frame) is None:
				raise RuntimeError("Native reply did not become visible; check the current pen tool")
			after.save(live_baseline(path))
		except Exception:
			answers[path] = "failed"
			raise
		reply_timings[path]["written"] = time.monotonic()
		answers[path] = "written"
		del ready[path]
		pend(path)
		print(time.strftime("%T"), "native answer written", path, "timing", json.dumps(timing_status(path)), file=sys.stderr, flush=True)
		return {"state": "written", "page": path, "live": True}


def mark_reply_timing(path, stage):
	"""Keep first/latest boundaries in the existing request-relative clock.

	Only fixed internal stage names are passed here. Re-entering preflight used
	to erase its initial start, hiding layout retries behind model latency.
	No new journal, payload logging, retry, or acceptance behavior is added.
	"""
	stages = reply_timings.setdefault(path, {})
	now = time.monotonic()
	stages.setdefault(stage+'_first', now)
	stages[stage] = now


def timing_status(path):
	times = reply_timings.get(path, {})
	start = times.get("respond")
	return {stage: round((at - start) * 1000) for stage, at in times.items()} if start is not None else {}


def answer_status(path):
	# Keep the request identity after pending removal so a failed tablet UI can
	# reconcile a confirmed save without resending or inserting the answer twice.
	request = next((job[4] for job in reversed(list(notebook_jobs.values()))
		if job[1] == path), None)
	job = notebook_jobs.get(request)
	media_pending = bool(job and len(job) > 5 and job[5] == "[[notebook-media-pending]]")
	if media_pending and answers.get(path) == "waiting" and time.time() - job[2] >= ANSWER_WAIT:
		answers[path] = "no answer"
		reply_errors[path] = "Image generation handoff timed out; the notebook input is preserved"
	started = reply_timings.get(path, {}).get("respond")
	return {"state": answers.get(path, "unknown"), "error": reply_errors.get(path),
		"timing_ms": timing_status(path), "request": request,
		"respond_elapsed_ms": max(0, round((time.monotonic() - started) * 1000)) if started is not None else None,
		"media_pending": media_pending,
		"retry_token": retry_requests.get(request) if answers.get(path) == "ready" and native_retry_safe(job) else None}


def incomplete_native_attempt(path):
	"""Read-only reopen hint from the EXISTING attempt; never a replay grant.

	A backend restart may restore the held reply as ready. The matching durable
	attempt still means insertion began but has no confirmed completion.
	"""
	job = next((j for j in reversed(list(notebook_jobs.values())) if j[1] == path), None)
	if (not job or len(job) < 7 or job[6] is not True or path not in ready or
		answers.get(path) not in ('ready','writing','failed')):
		return None
	try:
		with open(live_baseline(path)+'.native-attempt') as stream:
			if stream.read(128) == job[4]:
				return {'request':job[4]}
	except OSError:
		pass
	return None


def native_context_report(body):
	"""Geometry telemetry plus an explicitly admin-armed, pre-insertion repair hint."""
	result = device_context.update(body)
	if not result.get("accepted") or not body["active"]:
		return result
	result["keep_awake_seconds"] = device_context.awake_seconds(body["doc"])
	# The client sends one telemetry request at a time. Do not block its ACK
	# behind a slow source/media transfer: that would prevent later heartbeats
	# and make the preparation's own page guard fail as stale. Busy preparation
	# gets telemetry only, never a probe, audit move or repair command.
	if not pending_lock.acquire(blocking=False):
		return result
	try:
		if body.get('page'):
			result['incomplete_reply'] = incomplete_native_attempt(body['doc']+'/'+body['page']+'.rm')
		idle = answers.get(body['doc']+'/'+body['page']+'.rm', 'unknown') in ('unknown', 'written')
		audit = view_audit.command(body, idle=idle)
		if audit:
			result['audit_view'] = audit
		probe = native_probe.command(body)
		if probe:
			result["probe"] = probe
		if not retry_requests:
			return result
		path = body["doc"] + "/" + body["page"] + ".rm"
		job = next((job for job in reversed(list(notebook_jobs.values())) if job[1] == path), None)
		if job and path in ready and answers.get(path) == "ready" and retry_requests.get(job[4]) and native_retry_safe(job):
			result["repair"] = {"request": job[4], "token": retry_requests[job[4]]}
	finally:
		pending_lock.release()
	return result


def arm_view_audit(body):
