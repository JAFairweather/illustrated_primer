def with_story(image_context, png, question, request, path):
	"""image_context with the tale written first for the answering model to draw (notebook_image_model.story), told
	what a web search finds current when the question's text is known. Without a tale (a page that is not a lesson,
	the writer failing, or "story" off in the rollout file) the answering model gets the facts and writes its own."""
	found, config = '', lesson_rollout_config()
	if question:
		started = time.monotonic()
		try:
			found = notebook_image_model.facts(question)
		except Exception as error:  # the tale is still told from what the writer knows
			trace.event('facts', 'failed', request=request, path=path, reason=f'{type(error).__name__}: {error}'[:300])
		else:
			trace.event('facts', 'found' if found else 'none', request=request, path=path,
				ms=round((time.monotonic()-started)*1000), facts=found[:300] or None)
	if config.get('story'):
		started = time.monotonic()
		reader = config.get('reader') or 'James'
		opening = f"{reader}, {config.get('opening', 'once upon a time...')}"
		try:
			tale = notebook_image_model.story(png, question, found, reader=reader, opening=opening)
		except Exception as error:  # the answering model writes its own tale
			tale = None
			trace.event('story', 'failed', request=request, path=path, reason=f'{type(error).__name__}: {error}'[:300])
		else:
			note = tale and BEATS_NOTE % (json.dumps(tale['steps'], ensure_ascii=False),
				json.dumps(tale['takeaway'], ensure_ascii=False))
			# The opening note's rules are for a tale Pi Dog writes itself; on 2026-11-01 its 2 KB pushed Opus's
			# raven over the bound and Pi Dog told a thin one of its own.
			told = image_context.replace(OPENING_NOTE % opening, '')
			fits = bool(note) and len((told+note).encode()) <= 11300  # room for a repair note
			trace.event('story', 'written' if fits else 'too long' if note else 'not a lesson', request=request,
				path=path, ms=round((time.monotonic()-started)*1000), steps=len(tale['steps']) if tale else 0,
				bytes=len((told+note).encode()) if note else None)
			if fits:
				save_tale(path, tale)
				return told+note
	note = FACTS_NOTE % (time.strftime('%B %-d, %Y'), found) if found else ''
	return image_context+note if note and len((image_context+note).encode()) <= 11300 else image_context


