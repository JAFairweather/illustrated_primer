def direct_picture(reply):
	"""A picture for a lesson the model sent without one, written from its captions, or None. The answering model
	leaves it out now and then (Slightly Stoopid, the Riemann hypothesis); the page should not lose its picture."""
	captions = [s.get('caption', '') for s in reply.get('steps', []) if isinstance(s, dict)]
	if not captions or not all(isinstance(c, str) and c.strip() for c in captions):
		return None
	try:
		return _picture(notebook_image_model.direct(PICTURE_NOTE, str(reply.get('intent', '')), captions,
			str(reply.get('takeaway', ''))), len(captions))
	except Exception as error:  # the procedural drawing stands
		trace.event('picture', 'undirected', reason=f'{type(error).__name__}: {error}'[:300])
		return None


class Frames(list):
	labels = None  # per frame, [(name, 0..1000 box)] for the labels located in that frame
	scenes = False  # each frame a picture of its own, drawn below its caption
	steps = None  # the step each frame belongs to, when a step shares the picture above it


# Each frame of a new picture is a picture of its own under its paragraph (James, 2026-11-01: "inline each drawing
# with the text... instead of scrolling back up"); a picture kept from before is replayed as it was drawn, one growing
# picture.
SCENES = True


def picture_frames(picture):
	"""Frames already rendered for a reply's picture, with its located labels; never calls a model inside a tablet
	request."""
	try:
		frames = Frames(notebook_image_model.frames(picture['base'], picture['edits'], cached=True, scenes=True))
		frames.scenes = True
	except LookupError:  # drawn before pictures had scenes, or replayed from then
		frames = Frames(notebook_image_model.frames(picture['base'], picture['edits'], cached=True))
	frames.steps = notebook_image_model.drawn_steps(picture['edits'], len(frames))
	if picture.get('labels'):  # a picture that ended early keeps its earlier frames' labels
		labels = []
		for frame, names in zip(frames, [picture['labels'][s] for s in frames.steps if s < len(picture['labels'])]):
			try:
				boxes = notebook_image_model.locate(frame, names, cached=True) if names else {}
			except LookupError:  # that frame unlabeled
				boxes = {}
			labels.append([(n, boxes[n]) for n in names if n in boxes])
		frames.labels = labels
	return frames


def locate_labels(picture, frames, request=None, path=None):
	"""Find each frame's labels in that frame, off the tablet's request (each thing is named where it first appears, and
	a later edit may have dropped it); the count found, or None."""
	labels = picture.get('labels') or []
	labels = [labels[s] for s in notebook_image_model.drawn_steps(picture['edits'], len(frames)) if s < len(labels)]
	if not any(labels[:len(frames)]):
		return None
	def one(frame, names):
		try:
			return len(notebook_image_model.locate(frame, names)) if names else 0
		except Exception as error:  # the picture still draws, that frame unlabeled
			trace.event('labels', 'failed', request=request, path=path, reason=f'{type(error).__name__}: {error}'[:300])
			return 0
	from concurrent.futures import ThreadPoolExecutor
	with ThreadPoolExecutor(min(len(frames), len(labels))) as pool:
		return sum(pool.map(one, frames, labels))


