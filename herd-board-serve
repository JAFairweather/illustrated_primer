		"\n\nAnswer yes to send it, or no to drop it."), waiting


def page_send(parsed, request, path, current):
	"""What the page says for a send or confirm reply, and the message to hold for James's yes. Nothing leaves the
	tablet until he writes yes on the same page; then Pi Dog's own session posts a Buzz message, as Pi Dog, or the
	Mac's Messages app texts the note."""
	if parsed['mode'] == 'send' and parsed.get('via'):
		return text_send(parsed, request, path)
	if parsed['mode'] == 'send':
		known = {m.casefold(): m for m in BUZZ_MEMBERS}
		unknown = [n for n in parsed['to'] if n.casefold() not in known]
		if unknown:
			trace.event('sent', 'unknown', request=request, path=path, to=unknown)
			return (f"I could not find {', '.join(unknown)} on Buzz, so nothing is waiting to send. Write the request "
				f"again with one of: {', '.join(BUZZ_MEMBERS)}."), None
		to = list(dict.fromkeys(known[n.casefold()] for n in parsed['to']))
		trace.event('sent', 'shown', request=request, path=path, to=to, chars=len(parsed['text']))
		return (f"Ready to post on Buzz in #{BUZZ_CHANNEL[0]}, as Pi Dog, to {at(to)}:\n\n{parsed['text']}\n\n"
			"Answer yes to send it, or no to drop it."), {'to': to, 'text': parsed['text'],
			'request': request, 't': time.time()}
	with pending_lock:
		if not current():
			raise ModelTransportError('cancelled')
		waiting = waiting_send(path)
		pending_sends.pop(path, None)  # one yes sends once
	if not waiting:
		return 'There is no message waiting on this page, so nothing was sent.', None
	if not parsed['send']:
		trace.event('sent', 'dropped', request=request, path=path, shown=waiting['request'])
		return f"Not sent. The message to {recipient(waiting)} is dropped.", None
	if waiting.get('via'):
		try:
			notebook_messages.send_picture(waiting['via'], waiting['number'], waiting['png'], waiting['request'])
		except (OSError, subprocess.TimeoutExpired) as error:
			with pending_lock:
				pending_sends.setdefault(path, waiting)
			trace.event('sent', 'failed', request=request, path=path, shown=waiting['request'], via=waiting['via'],
				reason=f'{type(error).__name__}: {error}'[:300])
			return (f"Not sent: Messages on the Mac did not take it (it may be asking for permission). The note to "
				f"{recipient(waiting)} is still waiting; answer yes again to retry."), None
		trace.event('sent', 'handed', request=request, path=path, shown=waiting['request'], via=waiting['via'])
		return f"Handed to Messages to send to {recipient(waiting)}.", None
	try:
		pane = next((a['pane_id'] for a in agent_list() if a.get('name') == 'pidog'), None)
		if not pane:
			raise LookupError('Pi Dog has no desk open')
		send(pane, PIDOG_POST % (request, BUZZ_CHANNEL[1], json.dumps(waiting['to']), at(waiting['to'])+' '+waiting['text']))
	except Exception as error:
		with pending_lock:
			pending_sends.setdefault(path, waiting)  # still waiting: another yes tries again
		trace.event('sent', 'failed', request=request, path=path, shown=waiting['request'],
			reason=f'{type(error).__name__}: {error}'[:300])
		return (f"Not sent: Pi Dog could not be reached. The message to {at(waiting['to'])} is still waiting; answer yes "
			"again to retry."), None
	trace.event('sent', 'handed', request=request, path=path, shown=waiting['request'], to=waiting['to'])
	return f"Handed to Pi Dog to post on Buzz in #{BUZZ_CHANNEL[0]}, to {at(waiting['to'])}.", None


def lesson_notes(image_context, path=None):
	"""The sending, opening, figure and picture notes a lesson call carries after the page's description."""
	waiting = waiting_send(path)
	note = (CONFIRM_NOTE % (recipient(waiting), waiting['text']) if waiting else SEND_NOTE % ', '.join(BUZZ_MEMBERS))
	if len((image_context+note).encode()) <= 9000:
