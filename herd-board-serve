def native_blank_preflight(body):
	"""Diagnostic ONLY: never permit paste onto an existing working notebook."""
	for key in ("doc", "page", "source_doc", "source_page"):
		value = body.get(key)
		if not isinstance(value, str) or str(uuid.UUID(value)) != value:
			raise ValueError("native diagnostic requires canonical UUIDs")
	context = device_context.snapshot()
	if (not context.get("fresh") or not context.get("active") or context.get("ink_revision") != 0 or
		any(context.get(key) != body.get(key) for key in ("doc", "page", "surface")) or
		context.get("view") != [1, 0, 0, 1, -702, 0] or context["text_bounds"][3] != 0):
		raise ValueError("native paste diagnostic requires a fresh pristine unscrolled page")
	base = "/home/root/.local/share/remarkable/xochitl/"
	destination = json.loads(tablet("cat " + base + body["doc"] + ".metadata"))
	parent = destination.get("parent")
	if not isinstance(parent, str) or str(uuid.UUID(parent)) != parent or destination.get("visibleName") != "To pidog":
		raise ValueError("native paste requires its isolated diagnostic notebook")
	folder = json.loads(tablet("cat " + base + parent + ".metadata"))
	if folder.get("visibleName") != "Native clone tests (Codex)":
		raise ValueError("native paste is disabled outside its isolated diagnostic folder")
	source_meta = json.loads(tablet("cat " + base + body["source_doc"] + ".metadata"))
	if source_meta.get("parent") != parent or source_meta.get("visibleName") != "Procedural stroke sources":
		raise ValueError("native paste source must be generated ink in the same diagnostic folder")
	source = tablet("dd if=" + base + body["source_doc"] + "/" + body["source_page"] + ".rm bs=1024 count=256 2>/dev/null")
	if (not source.startswith(b"reMarkable .lines file, version=6") or len(source) >= 262144 or
		43 + sum(len(raw) for _, raw in blocks(source)) != len(source) or
		not {k for k, _ in blocks(source)} <= {0, 1, 2, 4, 5, 9, 10} or
		len(strokes(source)) != body.get("expected_strokes")):
		raise ValueError("native source asset failed its ink-only integrity/count preflight")
	target = base + body["doc"] + "/" + body["page"] + ".rm"
	saved = tablet("if test -f " + target + "; then dd if=" + target + " bs=1024 count=5 2>/dev/null; fi")
	if saved and (len(saved) > 4096 or strokes(saved) or
		any(kind not in {0, 1, 2, 4, 9, 10, 13, 14} for kind, raw in blocks(saved))):
		raise ValueError("native paste diagnostic refuses saved notebook content")
	frame = live_capture(tablet)
	if frame.crop((130, 210, 1304, 1792)).point(lambda value: 255 if value < 110 else 0).getbbox():
		raise ValueError("native paste diagnostic refuses visible notebook content")
	return hashlib.sha256(source).hexdigest()


def arm_native_probe(body):
	digest = native_blank_preflight(body) if body.get("operation") == "paste-blank-test" else None
	if body.get('operation') == 'text-anchor':
		digest = native_anchor_source_hash(body)
	if body.get('operation') == 'import-source':
		from notebook_lesson_native import inspect_source_archive
		for key in ('source_doc', 'source_parent', 'source_page'):
			if not isinstance(body.get(key), str) or str(uuid.UUID(body[key])) != body[key]:
				raise ValueError('canonical import source identity required')
		doc, parent = body['source_doc'], body['source_parent']
		if doc == body.get('doc'):
			raise ValueError('import source must be a new disposable document')
		if tablet(f'test ! -e {XOCHITL}/{doc}.metadata && test ! -e {XOCHITL}/{doc}.content && test ! -e {XOCHITL}/{doc} && printf fresh') != b'fresh':
			raise ValueError('import source UUID already exists')
		folder = json.loads(tablet(f'cat {XOCHITL}/{parent}.metadata'))
		if folder.get('visibleName') != 'Storyboard tests (Codex)' or folder.get('type') != 'CollectionType':
			raise ValueError('import probe requires the isolated source folder')
		data = tablet(f'dd if=/home/root/.cache/herd-board/imports/{doc}.rmdoc bs=2000001 count=1 2>/dev/null')
		digest = inspect_source_archive(data, doc, parent, body['source_page'], body.get('expected_strokes'))
	return native_probe.arm(body, device_context.snapshot(), source_sha256=digest)


def native_anchor_source_hash(body):
	"""Read-only diagnostic on a different saved page of our isolated fixture."""
	for key in ('source_doc', 'source_page'):
		if not isinstance(body.get(key), str) or str(uuid.UUID(body[key])) != body[key]:
			raise ValueError('canonical anchor source identity required')
	doc, page = body['source_doc'], body['source_page']
	if doc == body.get('doc') and page == body.get('page'):
		raise ValueError('anchor probe cannot focus the foreground page')
	metadata = json.loads(tablet(f'cat {XOCHITL}/{doc}.metadata'))
	parent = metadata.get('parent')
	if not isinstance(parent, str) or str(uuid.UUID(parent)) != parent:
		raise ValueError('anchor source requires isolated parent')
	folder = json.loads(tablet(f'cat {XOCHITL}/{parent}.metadata'))
	if folder.get('visibleName') != 'Storyboard tests (Codex)' or folder.get('type') != 'CollectionType':
		raise ValueError('anchor probe requires the isolated test folder')
	raw = tablet(f'dd if={XOCHITL}/{doc}/{page}.rm bs=262144 count=1 2>/dev/null')
	if not 43 <= len(raw) < 262144 or not raw.startswith(b'reMarkable .lines file, version=6'):
		raise ValueError('bounded saved anchor source required')
	return hashlib.sha256(raw).hexdigest()


def complete_native_probe(body):
	job = native_probe.current_job()
	if job and job.get('operation') == 'text-anchor' and body.get('state') == 'text-anchor':
		context = device_context.snapshot()
		if (body.get('id') != job['id'] or not context.get('fresh') or not context.get('active') or
			any(context.get(k) != job[k] for k in ('doc', 'page', 'surface')) or
			context.get('content_revision') != job['revision'] or context.get('ink_revision') != job['ink']):
			raise ValueError('foreground changed during anchor diagnostic')
		if native_anchor_source_hash(job) != job['source_sha256']:
			raise ValueError('anchor diagnostic source changed; result not accepted')
	if job and job.get('operation') == 'import-source' and body.get('state') == 'cloned':
		if body.get('id') != job['id']:
			raise ValueError('import probe result is stale')
		actual = body.get('imported_doc')
		if not isinstance(actual, str) or str(uuid.UUID(actual)) != actual or actual == job['doc']:
			raise ValueError('invalid imported source identity')
		page = body.get('imported_page')
		if not isinstance(page, str) or str(uuid.UUID(page)) != page:
			raise ValueError('invalid imported page identity')
		metadata = json.loads(tablet(f'cat {XOCHITL}/{actual}.metadata'))
		if metadata.get('visibleName') != 'Agent lesson source '+job['source_doc'] or metadata.get('parent') != job['source_parent']:
			raise ValueError('imported source identity or parent changed')
		content = json.loads(tablet(f'cat {XOCHITL}/{actual}.content'))
		if content['cPages']['pages'][0]['id'] != page:
			raise ValueError('imported first page identity changed')
		raw = tablet(f'dd if={XOCHITL}/{actual}/{page}.rm bs=262144 count=1 2>/dev/null')
		if len(raw) >= 262144 or hashlib.sha256(raw).hexdigest() != job['source_sha256']:
			raise ValueError('imported source bytes changed; no insertion authorized')
	return native_probe.complete(body)


def claim_native_probe(body):
	job = native_probe.current_job()
	if not job or body.get("id") != job["id"] or job["operation"] != "paste-blank-test":
		raise ValueError("no matching native blank diagnostic")
	if native_blank_preflight(job) != job["source_sha256"]:
