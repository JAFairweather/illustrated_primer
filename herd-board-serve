def at(names):
	return ' and '.join('@'+n for n in names)


def waiting_send(path):
	"""The Buzz message waiting on this page for James's yes, if it has not expired."""
	with pending_lock:
		waiting = pending_sends.get(path)
		if waiting and time.time()-waiting['t'] > SEND_KEEP:
			del pending_sends[path]
			trace.event('sent', 'expired', request=waiting['request'], path=path)
			waiting = None
	return waiting


def recipient(waiting):
	if waiting.get('via'):
		return f"{waiting['to'][0]} by {VIA[waiting['via']]} (number ending {notebook_messages.ending(waiting['number'])})"
	return at(waiting['to'])


def text_send(parsed, request, path):
