		trace.event('sent', 'unknown', request=request, path=path, via=via, matches=len(found))
		return ((f"I could not find {name} with a phone number in your contacts." if not found else
			f"{name} matches {', '.join(n for n, _ in found[:4])}. Write the request again with the full name."),
			None)
