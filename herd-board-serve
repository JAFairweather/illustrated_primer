# The tablet reports its page twice a second, but a busy moment on the tablet can delay
# one report past the 1.5 s freshness window (IRIS reply, 2026-10-30 15:18). A model call
# waits out a short gap; a changed page still stops it at once.
MODEL_PAGE_GRACE_MS = 6000


def model_page_stop_reason(before):
	"""Reuse native telemetry; no new lease, audit or tablet polling loop."""
	current = device_context.snapshot()
	late = current.get('available') and current.get('age_ms', MODEL_PAGE_GRACE_MS + 1) <= MODEL_PAGE_GRACE_MS
	if not current.get('active') or not (current.get('fresh') or late):
		return 'page_unavailable'
	if not all(before.get(k) is not None and before.get(k) == current.get(k) for k in
			('doc','page','surface','view','content_revision','ink_revision')):
		return 'page_changed'
	return None


def model_page_current(before):
	return model_page_stop_reason(before) is None


def notebook_answer_stream(body):
	"""Read complete answer records for one unchanged job; this is NOT an insertion ACK.

	Reads are repeatable so a lost HTTP response cannot lose text. The native
	consumer must own its consumed sequence and append range, never replay a
	consumed record. Until that consumer is installed no client advertises the
	capability required by respond(). No geometry or raw provider deltas escape.
	"""
	if (not isinstance(body, dict) or set(body) != {'request','page','after'} or
		not isinstance(body['request'], str) or not isinstance(body['page'], str) or
		type(body['after']) is not int or not -1 <= body['after'] <= 2):
		raise ValueError('Exact answer stream request, page and sequence required')
	with pending_lock:
		request, path = body['request'], body['page']
		stream = notebook_answer_streams.get(request)
		job = notebook_jobs.get(request)
		if (not stream or not job or job[1] != path or pend('').get(path) != job or
			time.time()-job[2] >= ANSWER_WAIT or body['after'] >= len(stream['chunks'])):
			raise ValueError('Answer stream is absent, expired, superseded or out of sequence')
		# A failed/changed page never exposes additional queued prose. Existing
		# page guards remain exact; native continuation must explicitly reconcile
		# its own acknowledged text changes before this route can be deployed.
		if stream['stopped'] or answers.get(path) == 'failed':
			return {'request':request,'state':'failed','chunks':[]}
		reason = model_page_stop_reason(stream['context'])
		if reason:
			stream['stopped'] = True
			answers[path] = 'failed'
			reply_errors[path] = 'Notebook model '+reason+'; request stopped before insertion; no automatic resend'
			return {'request':request,'state':'failed','chunks':[]}
		if answers.get(path) not in ('waiting','ready'):
			raise ValueError('Answer stream is not readable during native insertion')
		return {'request':request,'state':answers[path],
			'chunks':[dict(chunk) for chunk in stream['chunks'][body['after']+1:]]}


